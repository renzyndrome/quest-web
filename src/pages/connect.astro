---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import PillButton from '../components/PillButton.astro';
import Chip from '../components/Chip.astro';
import { GATHERINGS, LOCATIONS, MAIN_LOCATION, NEXT_STEPS, PASTORAL_SERVICES } from '../lib/site';
import { PASTORAL_TOPIC, QUESTION_TOPICS } from '../lib/question';

/*
  /services deep-links here as /connect?service=<slug>#ask. The slug is looked
  up in this build-time map by the client script, so an arbitrary ?service=
  value can never put text into the form.
*/
const SERVICE_NAMES = Object.fromEntries(
  PASTORAL_SERVICES.map((service) => [service.slug, service.name]),
);

// Two independent forms live on this page:
//  - Prayer request  → POST /api/prayer   (emails the Prayer Warriors team)
//  - Ask a question   → POST /api/question (emails the church admin inbox)
// Both degrade the same way: if the email backend is unconfigured or
// unreachable, the form composes the message, copies it, and hands off to
// Facebook Messenger (the church's real, monitored channel) — it never
// falsely claims the message was received.
// Confidential prayer requests must only ever reach the prayer team — never
// store request contents in the CMS or logs.

// FAQ content is plain church info. Keep answers short, warm, and non-salesy
// (see .claude/rules/design.md tone). Gathering names/times come from
// src/lib/site.ts and are shown as a highlighted list below.

// Google Maps embed for the main mission point in Biñan. A search query needs
// no API key. It renders lazily inside the collapsed FAQ item, so the heavy map
// only loads once that item is opened — keeping the page light on mobile
// (facade-style).
const MAP_QUERY = 'Quest Laguna Biñan';
const mapEmbedSrc = `https://maps.google.com/maps?q=${encodeURIComponent(MAP_QUERY)}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(MAP_QUERY)}`;

const faqs = [
  { kind: 'services', q: 'What time are your gatherings?' },
  {
    kind: 'location',
    q: 'Where are you located?',
    a: `Our main mission point is ${MAIN_LOCATION.name} on ${MAIN_LOCATION.address}. We also have satellite churches across Laguna, Cavite, and one in Hungary. Come as you are. Tap the map for directions.`,
  },
  {
    kind: 'text',
    q: "I'm new. What should I expect?",
    a: 'Come as you are. Family Reunion runs a little over an hour with worship and a message from the Word. Someone from our Guest Experience team will be glad to help you find your way around.',
  },
  {
    kind: 'text',
    q: 'Do you have something for the kids?',
    a: "Yes. NXTGN is our children's church, and it runs at the same time as Family Reunion. Your children are cared for and learning while you worship.",
  },
  {
    kind: 'text',
    q: 'How can I give?',
    a: 'You can give through GCash or in person during any service. See the Give page for the details.',
  },
  {
    kind: 'text',
    q: 'How do I join a ministry or serve?',
    a: 'Every gift has a place here. Visit the Ministries page to see the teams, or send us a message and we will help you find one to try.',
  },
] as const;
---

<Base title="Connect — Quest Laguna">
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-cream to-white" aria-hidden="true">
    </div>
    <div
      class="mx-auto grid max-w-[1080px] items-center gap-10 px-5 pt-[130px] pb-12 md:grid-cols-[1.3fr_1fr] md:px-10 md:pt-[150px] md:pb-16"
    >
      <div>
        <Eyebrow>Connect</Eyebrow>
        <h1 class="mt-4 text-4xl leading-[1.12] md:text-5xl">We'd love to hear from you.</h1>
        <p class="mt-5 max-w-xl text-base leading-[1.7] text-ink/65 md:text-lg">
          Send us a prayer request, ask a question, or just say hello. Someone from the church will
          get back to you.
        </p>
      </div>
      <PhotoSlot
        label="People praying together after service"
        src="/images/site/praying.webp"
        alt="Members gathered around one another in prayer"
        width={900}
        height={718}
        class="h-auto w-full"
      />
    </div>
  </section>

  <section class="px-5 pb-16 md:px-10 md:pb-24" aria-label="Prayer request">
    <div class="mx-auto grid max-w-[1080px] items-start gap-8 lg:grid-cols-[1.6fr_1fr]">
      <div class="rounded-card border border-ink/10 bg-white p-7 shadow-card md:p-10">
        <form id="prayer-form">
          <h2 class="text-2xl">Send a prayer request</h2>
          <p class="mt-2 text-sm text-ink/60">
            Our Prayer Warriors team prays over every request we receive.
          </p>

          <label class="mt-7 block">
            <span class="text-sm font-semibold">Name <span class="font-normal text-ink/45">(optional)</span></span>
            <input
              type="text"
              name="name"
              autocomplete="name"
              class="mt-1.5 w-full rounded-xl border border-ink/15 px-4 py-3 text-[15px] focus:border-brand focus:outline-none"
            />
          </label>

          <label class="mt-5 block">
            <span class="text-sm font-semibold">Your location</span>
            <div class="relative mt-1.5">
              <select
                name="location"
                class="w-full appearance-none rounded-xl border border-ink/15 bg-white px-4 py-3 pr-10 text-[15px] focus:border-brand focus:outline-none"
              >
                {
                  LOCATIONS.map((location) => (
                    <option value={location.name}>{location.name}</option>
                  ))
                }
                <option value="I'm not part of Quest yet">I'm not part of Quest yet</option>
              </select>
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-y-0 right-3.5 flex items-center text-ink/50"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </span>
            </div>
          </label>

          <label class="mt-5 block">
            <span class="text-sm font-semibold">Your request</span>
            <textarea
              name="request"
              required
              rows="5"
              class="mt-1.5 w-full rounded-xl border border-ink/15 px-4 py-3 text-[15px] focus:border-brand focus:outline-none"></textarea>
          </label>

          <label class="mt-5 flex items-start gap-3">
            <input type="checkbox" name="confidential" class="mt-0.5 h-4 w-4 accent-brand" />
            <span class="text-sm text-ink/70">
              Keep this confidential. Only the prayer team will read it.
            </span>
          </label>

          {/* Honeypot: hidden from people, bots fill it → request is dropped */}
          <div aria-hidden="true" class="absolute -left-[9999px] h-0 w-0 overflow-hidden">
            <label>
              Leave this field empty
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <p id="prayer-error" hidden class="mt-5 text-sm font-semibold text-brand" role="alert"></p>

          <button
            type="submit"
            data-submit
            class="mt-7 inline-flex min-h-11 items-center justify-center rounded-full bg-brand px-8 py-3 text-[15px] font-semibold text-white transition-colors duration-200 hover:bg-brand-press disabled:opacity-60"
          >
            Send request
          </button>
        </form>

        {/* Shown when the request was delivered to the prayer team by email */}
        <div id="prayer-received" hidden role="status" tabindex="-1" class="py-6 text-center">
          <div
            class="mx-auto flex h-[60px] w-[60px] items-center justify-center rounded-full bg-red-tint text-brand"
          >
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </div>
          <h2 class="mt-5 text-2xl">Thank you. We've received your request.</h2>
          <p class="mx-auto mt-3 max-w-md text-[15px] leading-[1.7] text-ink/65">
            Our Prayer Warriors will be praying with you this week. You're not alone.
          </p>
          <button
            type="button"
            data-reset
            class="mt-6 inline-flex min-h-11 items-center rounded-full border border-ink/20 px-7 py-3 text-[15px] font-semibold transition-colors duration-200 hover:bg-ink/5"
          >
            Send another request
          </button>
        </div>

        {/* Fallback when the email backend is unconfigured or unreachable */}
        <div id="prayer-fallback" hidden role="status" tabindex="-1" class="py-4">
          <div
            class="mx-auto flex h-[60px] w-[60px] items-center justify-center rounded-full bg-red-tint text-brand"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m22 2-11 11"></path>
              <path d="M22 2 15 22l-4-9-9-4 20-7z"></path>
            </svg>
          </div>
          <h2 class="mt-5 text-center text-2xl">One more tap and it's on its way.</h2>
          <p class="mx-auto mt-3 max-w-md text-center text-[15px] leading-[1.7] text-ink/65">
            Your request is ready below and copied for you. Paste it in our Facebook Messenger
            chat, and our Prayer Warriors will be praying with you this week.
          </p>
          <textarea
            id="prayer-composed"
            readonly
            rows="6"
            aria-label="Your composed prayer request"
            class="mt-5 w-full rounded-xl border border-ink/15 bg-cream px-4 py-3 text-[14px] leading-relaxed text-ink/80"></textarea>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
            <a
              href="https://m.me/questlaguna"
              rel="noopener"
              target="_blank"
              class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand px-8 py-3 text-[15px] font-semibold text-white transition-colors duration-200 hover:bg-brand-press"
            >
              Open Messenger
            </a>
            <button
              type="button"
              data-reset
              class="inline-flex min-h-11 items-center rounded-full border border-ink/20 px-7 py-3 text-[15px] font-semibold transition-colors duration-200 hover:bg-ink/5"
            >
              Edit my request
            </button>
          </div>
        </div>
      </div>

      <div class="space-y-5">
        <a
          href="https://facebook.com/questlaguna"
          rel="noopener"
          class="block rounded-card bg-cream p-7 transition-colors duration-200 hover:bg-cream-hover"
        >
          <h3 class="text-lg">Message us on Facebook</h3>
          <p class="mt-2 text-sm leading-[1.65] text-ink/65">
            The fastest way to reach us. We reply to every message.
          </p>
          <span class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-maroon underline underline-offset-4">
            facebook.com/questlaguna
          </span>
        </a>

        <a
          href="/visit"
          class="block rounded-card bg-cream p-7 transition-colors duration-200 hover:bg-cream-hover"
        >
          <h3 class="text-lg">Plan a visit</h3>
          <p class="mt-2 text-sm leading-[1.65] text-ink/65">
            Family Reunion is every Sunday at 10 AM. We gather in locations across Laguna and
            Cavite, so find the one nearest you.
          </p>
          <span class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-maroon underline underline-offset-4">
            Plan your first visit
          </span>
        </a>

        <div class="rounded-card border border-dashed border-maroon/35 p-7">
          <h3 class="text-lg">What happens to my request?</h3>
          <p class="mt-2 text-sm leading-[1.65] text-ink/65">
            It goes to our Prayer Warriors ministry. If you mark it confidential, only the prayer
            team reads it. Nothing is shared publicly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="ask" class="bg-cream px-5 py-16 md:px-10 md:py-20" aria-label="Ask a question">
    <div class="mx-auto max-w-[820px]">
      <div class="max-w-xl">
        <h2 class="text-2xl leading-[1.15] md:text-3xl">Have a question?</h2>
        <p class="mt-3 text-[15px] leading-[1.7] text-ink/65">
          New here, thinking of visiting, or wondering how to get involved? Send us a question and
          our team will get back to you.
        </p>
        <a
          href="/services"
          class="mt-2 inline-flex min-h-11 items-center text-sm font-semibold text-maroon underline underline-offset-4"
        >
          Planning a dedication, wedding, or baptism? See our pastoral services
        </a>
      </div>

      {/* Natural aspect: this is a wide group shot, and any fixed-height
          object-cover box crops people out of it. */}
      <PhotoSlot
        label="Our Guest Experience team welcomes every guest"
        src="/images/site/ministry-ushering.webp"
        alt="The Guest Experience Ministry team, who welcome guests each Sunday"
        width={900}
        height={413}
        class="mt-8 h-auto w-full"
      />

      <div class="mt-6 rounded-card border border-ink/10 bg-white p-7 shadow-card md:p-10">
        <form
          id="question-form"
          data-pastoral-topic={PASTORAL_TOPIC}
          data-services={JSON.stringify(SERVICE_NAMES)}
        >
          <div class="grid gap-5 md:grid-cols-2">
            <label class="block">
              <span class="text-sm font-semibold">Name <span class="font-normal text-ink/45">(optional)</span></span>
              <input
                type="text"
                name="name"
                autocomplete="name"
                class="mt-1.5 w-full rounded-xl border border-ink/15 px-4 py-3 text-[15px] focus:border-brand focus:outline-none"
              />
            </label>

            <label class="block">
              <span class="text-sm font-semibold">Email or contact <span class="font-normal text-ink/45">(optional)</span></span>
              <input
                type="text"
                name="contact"
                autocomplete="email"
                placeholder="So we can reply to you"
                class="mt-1.5 w-full rounded-xl border border-ink/15 px-4 py-3 text-[15px] focus:border-brand focus:outline-none"
              />
            </label>
          </div>

          <label class="mt-5 block">
            <span class="text-sm font-semibold">What's this about?</span>
            <div class="relative mt-1.5">
              <select
                name="topic"
                class="w-full appearance-none rounded-xl border border-ink/15 bg-white px-4 py-3 pr-10 text-[15px] focus:border-brand focus:outline-none"
              >
                {QUESTION_TOPICS.map((topic) => <option value={topic}>{topic}</option>)}
              </select>
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-y-0 right-3.5 flex items-center text-ink/50"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </span>
            </div>
          </label>

          <label class="mt-5 block">
            <span class="text-sm font-semibold">Your question</span>
            <textarea
              name="question"
              required
              rows="5"
              class="mt-1.5 w-full rounded-xl border border-ink/15 px-4 py-3 text-[15px] focus:border-brand focus:outline-none"></textarea>
          </label>

          {/* Honeypot: hidden from people, bots fill it → question is dropped */}
          <div aria-hidden="true" class="absolute -left-[9999px] h-0 w-0 overflow-hidden">
            <label>
              Leave this field empty
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <p id="question-error" hidden class="mt-5 text-sm font-semibold text-brand" role="alert"></p>

          <button
            type="submit"
            data-question-submit
            class="mt-7 inline-flex min-h-11 items-center justify-center rounded-full bg-brand px-8 py-3 text-[15px] font-semibold text-white transition-colors duration-200 hover:bg-brand-press disabled:opacity-60"
          >
            Send question
          </button>
        </form>

        {/* Shown when the question was delivered to the church inbox by email */}
        <div id="question-received" hidden role="status" tabindex="-1" class="py-6 text-center">
          <div
            class="mx-auto flex h-[60px] w-[60px] items-center justify-center rounded-full bg-red-tint text-brand"
          >
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </div>
          <h3 class="mt-5 text-2xl">Thank you. We've got your question.</h3>
          <p class="mx-auto mt-3 max-w-md text-[15px] leading-[1.7] text-ink/65">
            Someone from our team will get back to you soon.
          </p>
          <button
            type="button"
            data-question-reset
            class="mt-6 inline-flex min-h-11 items-center rounded-full border border-ink/20 px-7 py-3 text-[15px] font-semibold transition-colors duration-200 hover:bg-ink/5"
          >
            Ask another question
          </button>
        </div>

        {/* Fallback when the email backend is unconfigured or unreachable */}
        <div id="question-fallback" hidden role="status" tabindex="-1" class="py-4">
          <div
            class="mx-auto flex h-[60px] w-[60px] items-center justify-center rounded-full bg-red-tint text-brand"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m22 2-11 11"></path>
              <path d="M22 2 15 22l-4-9-9-4 20-7z"></path>
            </svg>
          </div>
          <h3 class="mt-5 text-center text-2xl">One more tap and it's on its way.</h3>
          <p class="mx-auto mt-3 max-w-md text-center text-[15px] leading-[1.7] text-ink/65">
            Your question is ready below and copied for you. Paste it in our Facebook Messenger chat
            and our team will reply.
          </p>
          <textarea
            id="question-composed"
            readonly
            rows="6"
            aria-label="Your composed question"
            class="mt-5 w-full rounded-xl border border-ink/15 bg-cream px-4 py-3 text-[14px] leading-relaxed text-ink/80"></textarea>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
            <a
              href="https://m.me/questlaguna"
              rel="noopener"
              target="_blank"
              class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand px-8 py-3 text-[15px] font-semibold text-white transition-colors duration-200 hover:bg-brand-press"
            >
              Open Messenger
            </a>
            <button
              type="button"
              data-question-reset
              class="inline-flex min-h-11 items-center rounded-full border border-ink/20 px-7 py-3 text-[15px] font-semibold transition-colors duration-200 hover:bg-ink/5"
            >
              Edit my question
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-5 py-16 md:px-10 md:py-24" aria-label="Your next steps">
    <div class="reveal mx-auto max-w-[1080px]">
      <div class="max-w-2xl">
        <h2 class="text-2xl leading-[1.15] md:text-3xl">Your next steps.</h2>
        <p class="mt-3 text-[15px] leading-[1.7] text-ink/65">
          Nobody rushes you through this. Each step is taken with people who know you, and there is
          always someone walking it with you.
        </p>
      </div>

      <div class="mt-10 grid gap-10 md:grid-cols-[1.15fr_1fr] md:items-start">
        <ol class="relative ml-3 border-l border-ink/12 pl-8">
          {
            NEXT_STEPS.map((step, i) => (
              <li class="relative pb-7 last:pb-0">
                <span
                  aria-hidden="true"
                  class="absolute -left-[44px] grid h-6 w-6 place-items-center rounded-full bg-brand text-[11px] font-bold text-white"
                >
                  {i + 1}
                </span>
                <h3 class="text-base leading-snug">{step.name}</h3>
                <p class="mt-1 text-sm leading-[1.65] text-ink/60">{step.blurb}</p>
              </li>
            ))
          }
        </ol>

        <div class="space-y-4">
          <PhotoSlot
            label="Water baptism at the main location"
            src="/images/site/baptism.webp"
            alt="Families gathered around the baptism pool at Quest Laguna"
            width={900}
            height={493}
            class="h-auto w-full"
          />
          <PhotoSlot
            label="A Life Group meeting in someone's home"
            src="/images/site/community.webp"
            alt="A Life Group gathered together in a home"
            width={900}
            height={718}
            class="h-auto w-full"
          />
          <div class="rounded-card bg-cream p-7">
            <h3 class="text-lg">Not sure where you are on this?</h3>
            <p class="mt-2 text-sm leading-[1.65] text-ink/65">
              That is normal. Send us a question above and we will point you to the next step that
              makes sense for you.
            </p>
            <div class="mt-5">
              <PillButton href="/about" variant="outline" size="sm">Get to know us</PillButton>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream px-5 py-16 md:px-10 md:py-24" aria-label="Frequently asked questions">
    <div class="reveal mx-auto max-w-[760px]">
      <div class="text-center">
        <h2 class="text-2xl leading-[1.15] md:text-3xl">Questions we hear a lot</h2>
      </div>

      <div class="mt-8 divide-y divide-ink/10 border-t border-b border-ink/10">
        {
          faqs.map((faq) => (
            <details class="group">
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-5 text-left text-base font-semibold text-ink marker:hidden">
                {faq.q}
                <span
                  aria-hidden="true"
                  class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-ink/15 text-maroon transition-transform duration-200 group-open:rotate-45"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                </span>
              </summary>
              {faq.kind === 'services' && (
                <ul class="space-y-3 pb-5">
                  {GATHERINGS.map((gathering) => (
                    <li>
                      <span class="flex flex-wrap items-center gap-2 font-semibold text-ink">
                        {gathering.name}
                        {gathering.online && <Chip variant="tint">Online</Chip>}
                      </span>
                      <span class="block text-sm text-ink/60">{gathering.schedule}</span>
                      <span class="block text-sm text-ink/60">{gathering.subtitle}</span>
                    </li>
                  ))}
                </ul>
              )}

              {faq.kind === 'location' && (
                <div class="pb-5">
                  <p class="text-[15px] leading-[1.7] text-ink/65">{faq.a}</p>
                  <iframe
                    title="Map to Quest Laguna in Biñan"
                    src={mapEmbedSrc}
                    height="240"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    class="mt-4 w-full rounded-media border border-ink/10"
                    style="border:0"
                  />
                  <a
                    href={mapLink}
                    rel="noopener"
                    target="_blank"
                    class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-maroon underline underline-offset-4"
                  >
                    Get directions
                  </a>
                </div>
              )}

              {faq.kind === 'text' && (
                <p class="pb-5 text-[15px] leading-[1.7] text-ink/65">{faq.a}</p>
              )}
            </details>
          ))
        }
      </div>

      <p class="mt-8 text-center text-sm text-ink/60">
        Didn't find your answer? Use the question form above or message us on Facebook.
      </p>
    </div>
  </section>

  <script>
    const form = document.getElementById('prayer-form') as HTMLFormElement | null;
    const received = document.getElementById('prayer-received');
    const fallback = document.getElementById('prayer-fallback');
    const errorEl = document.getElementById('prayer-error');
    const composed = document.getElementById('prayer-composed') as HTMLTextAreaElement | null;
    const submit = form?.querySelector<HTMLButtonElement>('[data-submit]');

    function showError(message: string) {
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    // Build the copy-paste message + open the Messenger handoff (used when the
    // email backend is unconfigured or unreachable).
    function toMessenger(data: FormData) {
      const name = String(data.get('name') ?? '').trim();
      const meta = [
        name ? `Name: ${name}` : null,
        `Location: ${data.get('location')}`,
        data.get('confidential') === 'on' ? 'Please keep this confidential.' : null,
      ].filter((line): line is string => line !== null);
      const message = ['Prayer request', ...meta, '', String(data.get('request') ?? '').trim()].join(
        '\n',
      );
      if (composed) composed.value = message;
      navigator.clipboard?.writeText(message).catch(() => {
        /* manual copy from the textarea still works */
      });
      if (form) form.hidden = true;
      if (fallback) {
        fallback.hidden = false;
        fallback.focus();
      }
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (errorEl) errorEl.hidden = true;
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const payload = {
        name: data.get('name'),
        location: data.get('location'),
        request: data.get('request'),
        confidential: data.get('confidential') === 'on',
        website: data.get('website'),
      };

      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }

      try {
        const res = await fetch('/api/prayer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          form.hidden = true;
          if (received) {
            received.hidden = false;
            received.focus();
          }
          return;
        }
        if (res.status === 400 || res.status === 429) {
          const body = await res.json().catch(() => ({}));
          showError(body.error ?? 'Something went wrong. Please try again.');
          return;
        }
        // 503 not configured, 502 send failed, or anything else → Messenger.
        toMessenger(data);
      } catch {
        // Network/offline → Messenger handoff.
        toMessenger(data);
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = 'Send request';
        }
      }
    });

    document.querySelectorAll<HTMLButtonElement>('[data-reset]').forEach((button) =>
      button.addEventListener('click', () => {
        if (received) received.hidden = true;
        if (fallback) fallback.hidden = true;
        if (errorEl) errorEl.hidden = true;
        if (form) {
          // Reset only from the "send another" success button, keep values on "edit".
          if (button.closest('#prayer-received')) form.reset();
          form.hidden = false;
        }
      }),
    );
  </script>

  <script>
    // "Ask a question" form — mirrors the prayer flow but posts to /api/question
    // (church admin inbox) and has no confidential handling.
    const qForm = document.getElementById('question-form') as HTMLFormElement | null;
    const qReceived = document.getElementById('question-received');
    const qFallback = document.getElementById('question-fallback');
    const qError = document.getElementById('question-error');
    const qComposed = document.getElementById('question-composed') as HTMLTextAreaElement | null;
    const qSubmit = qForm?.querySelector<HTMLButtonElement>('[data-question-submit]');

    function showQError(message: string) {
      if (!qError) return;
      qError.textContent = message;
      qError.hidden = false;
    }

    // Build the copy-paste message + open the Messenger handoff (used when the
    // email backend is unconfigured or unreachable).
    function questionToMessenger(data: FormData) {
      const name = String(data.get('name') ?? '').trim();
      const contact = String(data.get('contact') ?? '').trim();
      const meta = [
        name ? `Name: ${name}` : null,
        contact ? `Contact: ${contact}` : null,
        `About: ${data.get('topic')}`,
      ].filter((line): line is string => line !== null);
      const message = ['Question', ...meta, '', String(data.get('question') ?? '').trim()].join(
        '\n',
      );
      if (qComposed) qComposed.value = message;
      navigator.clipboard?.writeText(message).catch(() => {
        /* manual copy from the textarea still works */
      });
      if (qForm) qForm.hidden = true;
      if (qFallback) {
        qFallback.hidden = false;
        qFallback.focus();
      }
    }

    /*
      Deep link from /services: ?service=<slug> preselects the pastoral topic
      and opens the message with the service name, which is what lets the office
      forward it to the right coordinator without any per-service inbox.

      Both inputs are checked against values rendered at build time, so a
      hand-typed query string cannot inject text or an unknown topic. Without
      JavaScript the link still lands on #ask with the default topic.
    */
    const qParams = new URLSearchParams(location.search);
    const topicSelect = qForm?.querySelector<HTMLSelectElement>('[name="topic"]');
    const questionBox = qForm?.querySelector<HTMLTextAreaElement>('[name="question"]');
    const serviceNames: Record<string, string> = JSON.parse(qForm?.dataset.services ?? '{}');
    const deepLinkedService = serviceNames[qParams.get('service') ?? ''];
    const requestedTopic = deepLinkedService ? qForm?.dataset.pastoralTopic : qParams.get('topic');

    if (topicSelect && requestedTopic) {
      const known = [...topicSelect.options].some((option) => option.value === requestedTopic);
      if (known) topicSelect.value = requestedTopic;
    }
    if (questionBox && deepLinkedService && !questionBox.value) {
      questionBox.value = `About: ${deepLinkedService}\n\n`;
    }

    qForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (qError) qError.hidden = true;
      if (!qForm.reportValidity()) return;

      const data = new FormData(qForm);
      const payload = {
        name: data.get('name'),
        contact: data.get('contact'),
        topic: data.get('topic'),
        question: data.get('question'),
        website: data.get('website'),
      };

      if (qSubmit) {
        qSubmit.disabled = true;
        qSubmit.textContent = 'Sending…';
      }

      try {
        const res = await fetch('/api/question', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          qForm.hidden = true;
          if (qReceived) {
            qReceived.hidden = false;
            qReceived.focus();
          }
          return;
        }
        if (res.status === 400 || res.status === 429) {
          const body = await res.json().catch(() => ({}));
          showQError(body.error ?? 'Something went wrong. Please try again.');
          return;
        }
        // 503 not configured, 502 send failed, or anything else → Messenger.
        questionToMessenger(data);
      } catch {
        // Network/offline → Messenger handoff.
        questionToMessenger(data);
      } finally {
        if (qSubmit) {
          qSubmit.disabled = false;
          qSubmit.textContent = 'Send question';
        }
      }
    });

    document.querySelectorAll<HTMLButtonElement>('[data-question-reset]').forEach((button) =>
      button.addEventListener('click', () => {
        if (qReceived) qReceived.hidden = true;
        if (qFallback) qFallback.hidden = true;
        if (qError) qError.hidden = true;
        if (qForm) {
          // Reset only from the "ask another" success button, keep values on "edit".
          if (button.closest('#question-received')) qForm.reset();
          qForm.hidden = false;
        }
      }),
    );
  </script>
</Base>
