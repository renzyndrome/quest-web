---
/*
  A congregation photo, or a labelled placeholder for one that has not been
  supplied yet — mirrors the handoff's <image-slot> concept.

  Pass `src` (plus `alt`) and it renders the real photo; leave it off and the
  dashed placeholder describes the intended shot. Call sites without a photo
  yet need no changes.

  Photos live in public/images/site/ rather than the CMS on purpose: these are
  part of the page design, not editorial content, so they must render even
  when no CMS is reachable.

  Currently referenced by no page: the launch pass replaced every remaining
  placeholder with a real client photograph, and listings with no image now
  render as text rather than as a dashed box. Kept because the design rules
  name it as the tool for the next slot the church has not photographed yet
  (see .claude/rules/design.md).
*/
interface Props {
  label: string;
  class?: string;
  /** Real photo URL. Renders an <img> instead of the placeholder. */
  src?: string;
  /** Required whenever `src` is set — falls back to `label` otherwise. */
  alt?: string;
  /** Intrinsic size, to reserve space and avoid layout shift. */
  width?: number;
  height?: number;
  /** Set 'eager' for anything above the fold. */
  loading?: 'lazy' | 'eager';
}
const {
  label,
  class: className = '',
  src,
  alt,
  width = 900,
  height = 600,
  loading = 'lazy',
} = Astro.props;
---

{
  src ? (
    <img
      src={src}
      alt={alt ?? label}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      class:list={['rounded-media object-cover shadow-media', className]}
    />
  ) : (
    <div
      class:list={[
        'flex items-center justify-center overflow-hidden rounded-media border border-dashed border-maroon/35 bg-cream',
        className,
      ]}
      role="img"
      aria-label={`Photo placeholder: ${label}`}
    >
      <div class="flex flex-col items-center gap-2 px-4 py-6 text-center">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-maroon/50"
          aria-hidden="true"
        >
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <circle cx="9" cy="10" r="1.5"></circle>
          <path d="m21 15-4.5-4.5L9 18"></path>
        </svg>
        <span class="text-xs font-semibold text-maroon/70">{label}</span>
      </div>
    </div>
  )
}
