---
import Base from '../../layouts/Base.astro';
import EventDetail from '../../components/EventDetail.astro';
import { getUpcomingEvents, type ChurchEvent } from '../../lib/events';

// Only upcoming events get pages; past events age out at the next rebuild.
export async function getStaticPaths() {
  const events = await getUpcomingEvents();
  return events.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

interface Props {
  event: ChurchEvent;
}
const { event } = Astro.props;
---

<Base title={`${event.name} — Quest Laguna`}>
  <EventDetail event={event} />
</Base>
