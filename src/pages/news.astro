---
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import Chip from '../components/Chip.astro';
import EventCard from '../components/EventCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getAnnouncements, excerpt } from '../lib/cms';
import { getUpcomingEvents } from '../lib/events';

// News and Events share one slot in the header, so the next few events sit
// at the top of this page and the full list stays on /events.
const [announcements, events] = await Promise.all([getAnnouncements(), getUpcomingEvents()]);
const upcoming = events.slice(0, 3);
const pinned = announcements.find((item) => item.pinned);
const rest = announcements.filter((item) => item !== pinned);

function dateParts(iso: string) {
  const date = new Date(iso);
  return {
    day: date.toLocaleDateString('en-PH', { day: '2-digit' }),
    month: date.toLocaleDateString('en-PH', { month: 'short' }),
  };
}
const longDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' });
---

<Base
  title="News and announcements | Quest Laguna"
  description="News and announcements from Quest Laguna Church."
>
  <HeroBanner
    eyebrow="News & Events"
    title="News & announcements"
    body="What is happening across our locations, and what is coming up."
  />

  <section class="bg-cream px-gutter py-section-sm" aria-label="Upcoming events">
    <div class="mx-auto max-w-content">
      <SectionHeading title="Upcoming events.">
        <a
          slot="action"
          href="/events"
          class="inline-flex min-h-11 items-center text-small font-semibold text-maroon underline underline-offset-4"
        >
          All events
        </a>
      </SectionHeading>
      {
        upcoming.length > 0 ? (
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {upcoming.map((event) => (
              <EventCard event={event} />
            ))}
          </div>
        ) : (
          <p class="mt-4 text-body text-ink/65">
            No events scheduled at the moment. New events are posted on the Events page and on our
            Facebook page.
          </p>
        )
      }
    </div>
  </section>

  <section class="px-gutter py-section" aria-label="Announcements">
    <div class="mx-auto max-w-narrow">
      {
        pinned && (
          <article class="mb-10 rounded-card border border-maroon/15 bg-cream p-7 md:p-9">
            <div class="flex flex-wrap items-center gap-3">
              <span class="rounded-full bg-brand px-3.5 py-1.5 text-micro font-bold tracking-widest text-white uppercase">
                Pinned
              </span>
              <span class="text-small text-ink/55">
                {longDate(pinned.date)} · {pinned.category}
              </span>
            </div>
            {pinned.banner ? (
              <img
                src={pinned.banner ?? ''}
                alt={pinned.bannerAlt ?? ''}
                loading="lazy"
                width="1200"
                height="220"
                class="mt-5 h-[220px] w-full rounded-media object-cover"
              />
            ) : null}
            <h2 class="mt-5 text-title-lg">
              <a
                href={`/news/${pinned.slug}`}
                class="transition-colors duration-200 hover:text-maroon"
              >
                {pinned.title}
              </a>
            </h2>
            <p class="mt-2.5 text-body text-ink/65">{excerpt(pinned.body, 220)}</p>
            <a
              href={`/news/${pinned.slug}`}
              class="mt-3 inline-flex min-h-11 items-center text-small font-semibold text-maroon underline underline-offset-4"
            >
              Read the announcement
            </a>
          </article>
        )
      }

      {
        rest.map((item) => {
          const { day, month } = dateParts(item.date);
          return (
            <article class="flex gap-5 border-b border-ink/10 py-7">
              <div class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-tile bg-cream">
                <span class="display text-display-sm leading-none tabular-nums">{day}</span>
                <span class="mt-1 text-micro font-bold tracking-widest text-maroon uppercase">
                  {month}
                </span>
              </div>
              <div>
                <Chip>{item.category}</Chip>
                <h2 class="mt-2 text-title-lg">
                  <a
                    href={`/news/${item.slug}`}
                    class="transition-colors duration-200 hover:text-maroon"
                  >
                    {item.title}
                  </a>
                </h2>
                <p class="mt-1.5 text-body-sm text-ink/65">{excerpt(item.body)}</p>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>
</Base>
