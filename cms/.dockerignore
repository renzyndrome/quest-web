# Keep the build context small and reproducible. `npm ci` installs
# dependencies inside the image, so the host's copies must not be shipped in.
node_modules
.next

# Local-only artifacts
media
media-e2e
media-seed-test
e2e.db
e2e.db-journal
tc.db
build-check.db

# Local dev config — the real values come from the environment at runtime
.env
.env.*
!.env.example
local.env
docker-compose.local.yml

# Generated by `next dev`
AGENTS.md
CLAUDE.md

# NOTE: seed/ and src/migrations/ are intentionally NOT ignored — the boot
# sequence needs both (migrations always, seed assets when SEED_ON_BOOT=true).
