---
/*
  Category / status pill used on news rows, detail headers, and cards. The pill
  shape belongs to chips alone now that buttons are square-cornered.
*/
interface Props {
  variant?: 'outline' | 'tint' | 'on-dark';
  class?: string;
}
const { variant = 'outline', class: className = '' } = Astro.props;

const variants = {
  outline: 'border border-maroon/40 text-maroon',
  tint: 'bg-red-tint text-maroon',
  'on-dark': 'bg-white/12 text-white',
};
---

<span
  class:list={[
    'inline-block rounded-full px-2.5 py-0.5 text-micro font-bold tracking-widest uppercase',
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
