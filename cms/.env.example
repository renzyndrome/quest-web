# Payload CMS environment — set these in Dokploy (or copy to cms/.env for local).
# Generate secrets with: openssl rand -hex 32

# ── Core ────────────────────────────────────────────────────────────────
# PAYLOAD_SECRET encrypts API keys and signs tokens. Changing it invalidates
# every existing API key and login session.
PAYLOAD_SECRET=

# Postgres. The compose file BUILDS DATABASE_URI from the DB_* vars below, so
# in Dokploy you only need to set DB_PASSWORD (and optionally DB_USER /
# DB_DATABASE). Set DATABASE_URI directly only when pointing at an external
# database instead of the bundled postgres service.
DB_PASSWORD=
DB_USER=payload
DB_DATABASE=quest_content

# The public URL Payload is served from (the Dokploy domain). MEDIA URLS ARE
# BUILT FROM THIS. If it is wrong or still localhost, every image baked into
# the site points at a dead host. No trailing slash.
PAYLOAD_PUBLIC_SERVER_URL=https://cms.questlaguna.org

# Allowed browser origin for API calls (the public site).
SITE_ORIGIN=https://questlaguna.org
SITE_URL=https://questlaguna.org

# ── Publish → deploy ────────────────────────────────────────────────────
# Dokploy deploy hook for the SITE app. Called when an item becomes published
# (create or update) so fresh content bakes into a new build. Unset = no-op.
DOKPLOY_DEPLOY_URL=

# ── Submit → notify ─────────────────────────────────────────────────────
# Emails the approver when an editor moves an item to in_review. All three
# must be set or the hook no-ops. APPROVER_FROM_EMAIL must be a verified
# sender domain in Resend.
RESEND_API_KEY=
APPROVER_EMAIL=
APPROVER_FROM_EMAIL=

# ── Draft preview ───────────────────────────────────────────────────────
# Puts a "Preview" button next to Save on news, events and life testimonies,
# and turns the link in the approval email into a working one. It opens the
# site's preview route in a new tab, so drafts can be read as a real page
# before publishing.
#
# MUST match PREVIEW_SECRET on the SITE service exactly — the site is what
# validates the token. Unset here = no button (unset there = the route 404s).
# Every signed-in CMS user can read this value from the button's URL.
PREVIEW_SECRET=

# ── Uploads ─────────────────────────────────────────────────────────────
# Where uploaded media is written when R2 is NOT configured. The compose file
# mounts a volume here.
MEDIA_DIR=/app/media

# ── Object storage (Cloudflare R2) ──────────────────────────────────────
# Setting R2_BUCKET switches uploads from the droplet's volume to R2, and
# serves them from R2_PUBLIC_URL instead of through this CMS. Leave the whole
# block unset to keep using the volume — that is what local dev and the test
# suites do.
#
# Why: the droplet has no CDN, so every photo on the site is a round trip to
# one box for an audience that is mostly on mobile data — and the volume is
# the only thing here with no backup.
#
# R2_ACCOUNT_ID is the Cloudflare account id (R2 → Overview, or the dashboard
# URL). The key pair comes from R2 → Manage API tokens, scoped to this bucket
# with Object Read & Write. R2_PUBLIC_URL is the bucket's public custom domain
# — NOT the s3 endpoint — and must have no trailing slash, because it is baked
# into every <img src> on the public site.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# ── First-boot content ──────────────────────────────────────────────────
# Migrations always run on boot. Set this to "true" to ALSO seed the church's
# starting content (photo library, announcements, events, carousel slides)
# from cms/seed/. The seed is additive and never overwrites an existing item,
# so it is safe to leave on — but "false" after the first deploy keeps
# restarts quicker.
SEED_ON_BOOT=false

# ── Local development only — LEAVE UNSET IN PRODUCTION ──────────────────
# When both are set the seed creates an admin with these credentials. Unset
# (the production default) means Payload shows its onboarding screen so the
# first admin chooses their own password. See ../LOCAL.md.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
