---
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Button from '../components/Button.astro';
import Chip from '../components/Chip.astro';
import { FIRST_VISIT, GATHERINGS, LOCATIONS, MAIN_LOCATION, PASTORAL_SERVICES } from '../lib/site';
import { PASTORAL_TOPIC, QUESTION_TOPICS } from '../lib/question';

/*
  /services deep-links here as /connect?service=<slug>#ask. The slug is looked
  up in this build-time map by the client script, so an arbitrary ?service=
  value can never put text into the form.
*/
const SERVICE_NAMES = Object.fromEntries(
  PASTORAL_SERVICES.map((service) => [service.slug, service.name]),
);

// Two independent forms live on this page:
//  - Prayer request  → POST /api/prayer   (emails the Prayer Warriors team)
//  - Ask a question   → POST /api/question (emails the church admin inbox)
// Both degrade the same way: if the email backend is unconfigured or
// unreachable, the form composes the message, copies it, and hands off to
// Facebook Messenger (the church's real, monitored channel) — it never
// falsely claims the message was received.
// Confidential prayer requests must only ever reach the prayer team — never
// store request contents in the CMS or logs.

// FAQ content is plain church info. Keep answers short and plain (see
// .claude/rules/design.md tone). Gathering names and times come from
// src/lib/site.ts; the first-visit answers come from FIRST_VISIT there too, so
// this page and /visit can never state the same fact two different ways.

// Keyless Google Maps search for the main mission point, loaded on tap by
// MapEmbed rather than as a raw iframe.
const MAP_QUERY = 'Quest Laguna Biñan';

const faqs = [
  { kind: 'services', q: 'What time are your gatherings?' },
  {
    kind: 'location',
    q: 'Where are you located?',
    a: `The main mission point is ${MAIN_LOCATION.name} on ${MAIN_LOCATION.address}. There are also satellite churches across Laguna, Cavite, and one in Hungary. The map below has directions.`,
  },
  {
    kind: 'text',
    q: 'What should a first-time visitor expect?',
    a: `${FIRST_VISIT.dressCode} ${FIRST_VISIT.length} ${FIRST_VISIT.welcome}`,
  },
  {
    kind: 'text',
    q: 'Do you have something for the kids?',
    a: `Yes. ${FIRST_VISIT.kids}`,
  },
  {
    kind: 'text',
    q: 'How can I give?',
    a: 'Through GCash or in person at any gathering. Details are on the Give page.',
  },
  {
    kind: 'text',
    q: 'How do I join a ministry or serve?',
    a: 'The Ministries page lists the teams. The pastor at your location can suggest one to try.',
  },
] as const;
---

<Base
  title="Connect | Quest Laguna"
  description="Send a prayer request or ask a question. Contact Quest Laguna Church in Biñan City, Laguna."
>
  <HeroBanner
    eyebrow="Connect"
    title="Get in touch."
    body="Send a prayer request or ask a question. Someone from the church will reply."
  >
    <img
      slot="aside"
      src="/images/site/praying.webp"
      alt="Members gathered around one another in prayer"
      width={900}
      height={718}
      class="h-auto w-full rounded-media shadow-media"
    />
  </HeroBanner>

  <section class="px-gutter py-section" aria-label="Prayer request">
    <div class="mx-auto grid max-w-content items-start gap-8 lg:grid-cols-[1.6fr_1fr]">
      <div class="rounded-card border border-ink/10 bg-white p-7 md:p-10">
        <form id="prayer-form">
          <h2 class="text-title-lg">Send a prayer request</h2>
          <p class="mt-2 text-body-sm text-ink/60">
            The Prayer Warriors ministry prays over every request.
          </p>

          <label class="mt-7 block">
            <span class="text-small font-semibold">Name <span class="font-normal text-ink/45">(optional)</span></span>
            <input
              type="text"
              name="name"
              autocomplete="name"
              class="mt-1.5 w-full rounded-tile border border-ink/15 px-4 py-3 text-body-sm focus:border-brand focus:outline-none"
            />
          </label>

          <label class="mt-5 block">
            <span class="text-small font-semibold">Your location</span>
            <div class="relative mt-1.5">
              <select
                name="location"
                class="w-full appearance-none rounded-tile border border-ink/15 bg-white px-4 py-3 pr-10 text-body-sm focus:border-brand focus:outline-none"
              >
                {
                  LOCATIONS.map((location) => (
                    <option value={location.name}>{location.name}</option>
                  ))
                }
                <option value="Not part of Quest yet">Not part of Quest yet</option>
              </select>
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-y-0 right-3.5 flex items-center text-ink/50"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </span>
            </div>
          </label>

          <label class="mt-5 block">
            <span class="text-small font-semibold">Your request</span>
            <textarea
              name="request"
              required
              rows="5"
              class="mt-1.5 w-full rounded-tile border border-ink/15 px-4 py-3 text-body-sm focus:border-brand focus:outline-none"></textarea>
          </label>

          <label class="mt-5 flex items-start gap-3">
            <input type="checkbox" name="confidential" class="mt-0.5 h-5 w-5 shrink-0 accent-brand" />
            <span class="text-small text-ink/70">
              Keep this confidential. Only the prayer team will read it.
            </span>
          </label>

          {/* Honeypot: hidden from people, bots fill it → request is dropped */}
          <div aria-hidden="true" class="absolute -left-[9999px] h-0 w-0 overflow-hidden">
            <label>
              Leave this field empty
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <p id="prayer-error" hidden class="mt-5 text-small font-semibold text-brand" role="alert"></p>

          <button
            type="submit"
            data-submit
            class="mt-7 inline-flex min-h-11 items-center justify-center rounded-btn bg-brand px-6 py-3 text-body-sm font-semibold text-white transition-colors duration-200 hover:bg-brand-press disabled:opacity-60"
          >
            Send request
          </button>
        </form>

        {/* Shown when the request was delivered to the prayer team by email */}
        <div id="prayer-received" hidden role="status" tabindex="-1" class="py-6 text-center">
          <div
            class="mx-auto flex h-[60px] w-[60px] items-center justify-center rounded-full bg-red-tint text-brand"
          >
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </div>
          <h2 class="mt-5 text-title-lg">Thank you. Your request has been received</h2>
          <p class="mx-auto mt-3 max-w-md text-body text-ink/65">
            The Prayer Warriors will pray over it this week.
          </p>
          <button
            type="button"
            data-reset
            class="mt-6 inline-flex min-h-11 items-center rounded-btn border border-ink/20 px-6 py-3 text-body-sm font-semibold transition-colors duration-200 hover:bg-ink/5"
          >
            Send another request
          </button>
        </div>

        {/* Fallback when the email backend is unconfigured or unreachable */}
        <div id="prayer-fallback" hidden role="status" tabindex="-1" class="py-4">
          <div
            class="mx-auto flex h-[60px] w-[60px] items-center justify-center rounded-full bg-red-tint text-brand"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m22 2-11 11"></path>
              <path d="M22 2 15 22l-4-9-9-4 20-7z"></path>
            </svg>
          </div>
          <h2 class="mt-5 text-center text-title-lg">One more step</h2>
          <p class="mx-auto mt-3 max-w-md text-center text-body text-ink/65">
            Your request is composed below and copied to the clipboard. Paste it into our Facebook
            Messenger chat and it will reach the prayer team.
          </p>
          <textarea
            id="prayer-composed"
            readonly
            rows="6"
            aria-label="Your composed prayer request"
            class="mt-5 w-full rounded-tile border border-ink/15 bg-cream px-4 py-3 text-small leading-relaxed text-ink/80"></textarea>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
            <a
              href="https://m.me/questlaguna"
              rel="noopener"
              target="_blank"
              class="inline-flex min-h-11 items-center justify-center rounded-btn bg-brand px-6 py-3 text-body-sm font-semibold text-white transition-colors duration-200 hover:bg-brand-press"
            >
              Open Messenger
            </a>
            <button
              type="button"
              data-reset
              class="inline-flex min-h-11 items-center rounded-btn border border-ink/20 px-6 py-3 text-body-sm font-semibold transition-colors duration-200 hover:bg-ink/5"
            >
              Edit my request
            </button>
          </div>
        </div>
      </div>

      <div class="space-y-5">
        <a
          href="https://facebook.com/questlaguna"
          rel="noopener"
          class="block rounded-card border border-cream-200 bg-cream p-7 transition-colors duration-200 hover:bg-cream-hover"
        >
          <h3 class="text-title">Message us on Facebook</h3>
          <p class="mt-2 text-body-sm text-ink/65">The quickest way to reach the church.</p>
          <span class="mt-3 inline-flex min-h-11 items-center text-small font-semibold text-maroon underline underline-offset-4">
            facebook.com/questlaguna
          </span>
        </a>

        <a
          href="/visit"
          class="block rounded-card border border-cream-200 bg-cream p-7 transition-colors duration-200 hover:bg-cream-hover"
        >
          <h3 class="text-title">Plan a visit</h3>
          <p class="mt-2 text-body-sm text-ink/65">
            Family Reunion is every Sunday at 10:00 AM. Gathering times, directions, and what to
            expect.
          </p>
          <span class="mt-3 inline-flex min-h-11 items-center text-small font-semibold text-maroon underline underline-offset-4">
            Plan a visit
          </span>
        </a>

        <a
          href="/#next-steps"
          class="block rounded-card border border-cream-200 bg-cream p-7 transition-colors duration-200 hover:bg-cream-hover"
        >
          <h3 class="text-title">Next steps</h3>
          <p class="mt-2 text-body-sm text-ink/65">
            The steps from a first visit to serving are on the home page.
          </p>
          <span class="mt-3 inline-flex min-h-11 items-center text-small font-semibold text-maroon underline underline-offset-4">
            See the next steps
          </span>
        </a>

        <div class="rounded-card border border-ink/10 p-7">
          <h3 class="text-title">What happens to my request?</h3>
          <p class="mt-2 text-body-sm text-ink/65">
            It goes to the Prayer Warriors ministry. If it is marked confidential, only the prayer
            team reads it. Nothing is shared publicly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="ask" class="bg-cream px-gutter py-section" aria-label="Ask a question">
    <div class="mx-auto max-w-narrow">
      <SectionHeading
        title="Ask a question."
        body="Questions about visiting, serving, giving, or membership. Someone from the office will reply."
      />
      <p class="mt-3 text-body-sm text-ink/65">
        Dedications, weddings, funerals, counseling, and baptism are booked through <a
          href="/services"
          class="font-semibold text-maroon underline underline-offset-4">Pastoral services</a
        >.
      </p>

      <div class="mt-8 rounded-card border border-cream-200 bg-white p-7 md:p-10">
        <form
          id="question-form"
          data-pastoral-topic={PASTORAL_TOPIC}
          data-services={JSON.stringify(SERVICE_NAMES)}
        >
          <div class="grid gap-5 md:grid-cols-2">
            <label class="block">
              <span class="text-small font-semibold">Name <span class="font-normal text-ink/45">(optional)</span></span>
              <input
                type="text"
                name="name"
                autocomplete="name"
                class="mt-1.5 w-full rounded-tile border border-ink/15 px-4 py-3 text-body-sm focus:border-brand focus:outline-none"
              />
            </label>

            <label class="block">
              <span class="text-small font-semibold">Email or contact <span class="font-normal text-ink/45">(optional)</span></span>
              <input
                type="text"
                name="contact"
                autocomplete="email"
                placeholder="So we can reply to you"
                class="mt-1.5 w-full rounded-tile border border-ink/15 px-4 py-3 text-body-sm focus:border-brand focus:outline-none"
              />
            </label>
          </div>

          <label class="mt-5 block">
            <span class="text-small font-semibold">Topic</span>
            <div class="relative mt-1.5">
              <select
                name="topic"
                class="w-full appearance-none rounded-tile border border-ink/15 bg-white px-4 py-3 pr-10 text-body-sm focus:border-brand focus:outline-none"
              >
                {QUESTION_TOPICS.map((topic) => <option value={topic}>{topic}</option>)}
              </select>
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-y-0 right-3.5 flex items-center text-ink/50"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </span>
            </div>
          </label>

          <label class="mt-5 block">
            <span class="text-small font-semibold">Your question</span>
            <textarea
              name="question"
              required
              rows="5"
              class="mt-1.5 w-full rounded-tile border border-ink/15 px-4 py-3 text-body-sm focus:border-brand focus:outline-none"></textarea>
          </label>

          {/* Honeypot: hidden from people, bots fill it → question is dropped */}
          <div aria-hidden="true" class="absolute -left-[9999px] h-0 w-0 overflow-hidden">
            <label>
              Leave this field empty
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <p id="question-error" hidden class="mt-5 text-small font-semibold text-brand" role="alert"></p>

          <button
            type="submit"
            data-question-submit
            class="mt-7 inline-flex min-h-11 items-center justify-center rounded-btn bg-brand px-6 py-3 text-body-sm font-semibold text-white transition-colors duration-200 hover:bg-brand-press disabled:opacity-60"
          >
            Send question
          </button>
        </form>

        {/* Shown when the question was delivered to the church inbox by email */}
        <div id="question-received" hidden role="status" tabindex="-1" class="py-6 text-center">
          <div
            class="mx-auto flex h-[60px] w-[60px] items-center justify-center rounded-full bg-red-tint text-brand"
          >
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </div>
          <h3 class="mt-5 text-title-lg">Thank you. Your question has been received</h3>
          <p class="mx-auto mt-3 max-w-md text-body text-ink/65">
            Someone from the office will reply.
          </p>
          <button
            type="button"
            data-question-reset
            class="mt-6 inline-flex min-h-11 items-center rounded-btn border border-ink/20 px-6 py-3 text-body-sm font-semibold transition-colors duration-200 hover:bg-ink/5"
          >
            Ask another question
          </button>
        </div>

        {/* Fallback when the email backend is unconfigured or unreachable */}
        <div id="question-fallback" hidden role="status" tabindex="-1" class="py-4">
          <div
            class="mx-auto flex h-[60px] w-[60px] items-center justify-center rounded-full bg-red-tint text-brand"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m22 2-11 11"></path>
              <path d="M22 2 15 22l-4-9-9-4 20-7z"></path>
            </svg>
          </div>
          <h3 class="mt-5 text-center text-title-lg">One more step</h3>
          <p class="mx-auto mt-3 max-w-md text-center text-body text-ink/65">
            Your question is composed below and copied to the clipboard. Paste it into our Facebook
            Messenger chat and the office will reply.
          </p>
          <textarea
            id="question-composed"
            readonly
            rows="6"
            aria-label="Your composed question"
            class="mt-5 w-full rounded-tile border border-ink/15 bg-cream px-4 py-3 text-small leading-relaxed text-ink/80"></textarea>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
            <a
              href="https://m.me/questlaguna"
              rel="noopener"
              target="_blank"
              class="inline-flex min-h-11 items-center justify-center rounded-btn bg-brand px-6 py-3 text-body-sm font-semibold text-white transition-colors duration-200 hover:bg-brand-press"
            >
              Open Messenger
            </a>
            <button
              type="button"
              data-question-reset
              class="inline-flex min-h-11 items-center rounded-btn border border-ink/20 px-6 py-3 text-body-sm font-semibold transition-colors duration-200 hover:bg-ink/5"
            >
              Edit my question
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-gutter py-section" aria-label="Frequently asked questions">
    <div class="mx-auto max-w-narrow">
      <SectionHeading title="Common questions" />

      <div class="mt-8 divide-y divide-ink/10 border-y border-ink/10">
        {
          faqs.map((faq) => (
            <details class="group">
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-5 text-left text-title font-semibold text-ink [&::-webkit-details-marker]:hidden">
                {faq.q}
                <span
                  aria-hidden="true"
                  class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-ink/15 text-maroon transition-transform duration-200 group-open:rotate-45"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                </span>
              </summary>
              {faq.kind === 'services' && (
                <ul class="space-y-3 pb-5">
                  {GATHERINGS.map((gathering) => (
                    <li>
                      <span class="flex flex-wrap items-center gap-2 font-semibold text-ink">
                        {gathering.name}
                        {gathering.online && <Chip variant="tint">Online</Chip>}
                      </span>
                      <span class="block text-body-sm text-ink/60">{gathering.schedule}</span>
                      <span class="block text-body-sm text-ink/60">{gathering.subtitle}</span>
                    </li>
                  ))}
                </ul>
              )}

              {faq.kind === 'location' && (
                <div class="pb-5">
                  <p class="text-body text-ink/65">{faq.a}</p>
                  <MapEmbed
                    query={MAP_QUERY}
                    address={MAIN_LOCATION.address ?? ''}
                    height={240}
                    class="mt-4"
                  />
                </div>
              )}

              {faq.kind === 'text' && (
                <p class="pb-5 text-body text-ink/65">{faq.a}</p>
              )}
            </details>
          ))
        }
      </div>

      <p class="mt-8 text-body-sm text-ink/60">
        Other questions can go through the form above or by Facebook message.
      </p>
    </div>
  </section>

  <script>
    const form = document.getElementById('prayer-form') as HTMLFormElement | null;
    const received = document.getElementById('prayer-received');
    const fallback = document.getElementById('prayer-fallback');
    const errorEl = document.getElementById('prayer-error');
    const composed = document.getElementById('prayer-composed') as HTMLTextAreaElement | null;
    const submit = form?.querySelector<HTMLButtonElement>('[data-submit]');

    function showError(message: string) {
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    // Build the copy-paste message + open the Messenger handoff (used when the
    // email backend is unconfigured or unreachable).
    function toMessenger(data: FormData) {
      const name = String(data.get('name') ?? '').trim();
      const meta = [
        name ? `Name: ${name}` : null,
        `Location: ${data.get('location')}`,
        data.get('confidential') === 'on' ? 'Please keep this confidential.' : null,
      ].filter((line): line is string => line !== null);
      const message = ['Prayer request', ...meta, '', String(data.get('request') ?? '').trim()].join(
        '\n',
      );
      if (composed) composed.value = message;
      navigator.clipboard?.writeText(message).catch(() => {
        /* manual copy from the textarea still works */
      });
      if (form) form.hidden = true;
      if (fallback) {
        fallback.hidden = false;
        fallback.focus();
      }
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (errorEl) errorEl.hidden = true;
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const payload = {
        name: data.get('name'),
        location: data.get('location'),
        request: data.get('request'),
        confidential: data.get('confidential') === 'on',
        website: data.get('website'),
      };

      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }

      try {
        const res = await fetch('/api/prayer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          form.hidden = true;
          if (received) {
            received.hidden = false;
            received.focus();
          }
          return;
        }
        if (res.status === 400 || res.status === 429) {
          const body = await res.json().catch(() => ({}));
          showError(body.error ?? 'Something went wrong. Please try again.');
          return;
        }
        // 503 not configured, 502 send failed, or anything else → Messenger.
        toMessenger(data);
      } catch {
        // Network/offline → Messenger handoff.
        toMessenger(data);
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = 'Send request';
        }
      }
    });

    document.querySelectorAll<HTMLButtonElement>('[data-reset]').forEach((button) =>
      button.addEventListener('click', () => {
        if (received) received.hidden = true;
        if (fallback) fallback.hidden = true;
        if (errorEl) errorEl.hidden = true;
        if (form) {
          // Reset only from the "send another" success button, keep values on "edit".
          if (button.closest('#prayer-received')) form.reset();
          form.hidden = false;
        }
      }),
    );
  </script>

  <script>
    // "Ask a question" form — mirrors the prayer flow but posts to /api/question
    // (church admin inbox) and has no confidential handling.
    const qForm = document.getElementById('question-form') as HTMLFormElement | null;
    const qReceived = document.getElementById('question-received');
    const qFallback = document.getElementById('question-fallback');
    const qError = document.getElementById('question-error');
    const qComposed = document.getElementById('question-composed') as HTMLTextAreaElement | null;
    const qSubmit = qForm?.querySelector<HTMLButtonElement>('[data-question-submit]');

    function showQError(message: string) {
      if (!qError) return;
      qError.textContent = message;
      qError.hidden = false;
    }

    // Build the copy-paste message + open the Messenger handoff (used when the
    // email backend is unconfigured or unreachable).
    function questionToMessenger(data: FormData) {
      const name = String(data.get('name') ?? '').trim();
      const contact = String(data.get('contact') ?? '').trim();
      const meta = [
        name ? `Name: ${name}` : null,
        contact ? `Contact: ${contact}` : null,
        `About: ${data.get('topic')}`,
      ].filter((line): line is string => line !== null);
      const message = ['Question', ...meta, '', String(data.get('question') ?? '').trim()].join(
        '\n',
      );
      if (qComposed) qComposed.value = message;
      navigator.clipboard?.writeText(message).catch(() => {
        /* manual copy from the textarea still works */
      });
      if (qForm) qForm.hidden = true;
      if (qFallback) {
        qFallback.hidden = false;
        qFallback.focus();
      }
    }

    /*
      Deep link from /services: ?service=<slug> preselects the pastoral topic
      and opens the message with the service name, which is what lets the office
      forward it to the right coordinator without any per-service inbox.

      Both inputs are checked against values rendered at build time, so a
      hand-typed query string cannot inject text or an unknown topic. Without
      JavaScript the link still lands on #ask with the default topic.
    */
    const qParams = new URLSearchParams(location.search);
    const topicSelect = qForm?.querySelector<HTMLSelectElement>('[name="topic"]');
    const questionBox = qForm?.querySelector<HTMLTextAreaElement>('[name="question"]');
    const serviceNames: Record<string, string> = JSON.parse(qForm?.dataset.services ?? '{}');
    const deepLinkedService = serviceNames[qParams.get('service') ?? ''];
    const requestedTopic = deepLinkedService ? qForm?.dataset.pastoralTopic : qParams.get('topic');

    if (topicSelect && requestedTopic) {
      const known = [...topicSelect.options].some((option) => option.value === requestedTopic);
      if (known) topicSelect.value = requestedTopic;
    }
    if (questionBox && deepLinkedService && !questionBox.value) {
      questionBox.value = `About: ${deepLinkedService}\n\n`;
    }

    qForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (qError) qError.hidden = true;
      if (!qForm.reportValidity()) return;

      const data = new FormData(qForm);
      const payload = {
        name: data.get('name'),
        contact: data.get('contact'),
        topic: data.get('topic'),
        question: data.get('question'),
        website: data.get('website'),
      };

      if (qSubmit) {
        qSubmit.disabled = true;
        qSubmit.textContent = 'Sending…';
      }

      try {
        const res = await fetch('/api/question', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          qForm.hidden = true;
          if (qReceived) {
            qReceived.hidden = false;
            qReceived.focus();
          }
          return;
        }
        if (res.status === 400 || res.status === 429) {
          const body = await res.json().catch(() => ({}));
          showQError(body.error ?? 'Something went wrong. Please try again.');
          return;
        }
        // 503 not configured, 502 send failed, or anything else → Messenger.
        questionToMessenger(data);
      } catch {
        // Network/offline → Messenger handoff.
        questionToMessenger(data);
      } finally {
        if (qSubmit) {
          qSubmit.disabled = false;
          qSubmit.textContent = 'Send question';
        }
      }
    });

    document.querySelectorAll<HTMLButtonElement>('[data-question-reset]').forEach((button) =>
      button.addEventListener('click', () => {
        if (qReceived) qReceived.hidden = true;
        if (qFallback) qFallback.hidden = true;
        if (qError) qError.hidden = true;
        if (qForm) {
          // Reset only from the "ask another" success button, keep values on "edit".
          if (button.closest('#question-received')) qForm.reset();
          qForm.hidden = false;
        }
      }),
    );
  </script>
</Base>
