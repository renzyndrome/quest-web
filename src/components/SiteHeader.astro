---
import { FOOTER_LINKS, NAV } from '../lib/site';
import Button from './Button.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = NAV.filter((item) => !('cta' in item && item.cta));
const cta = NAV.find((item) => 'cta' in item && item.cta) ?? {
  label: 'Plan a visit',
  href: '/visit',
};

/** Current-page test: exact href, or any listed prefix (News & Events covers both sections). */
function isCurrent(item: { href: string; matches?: readonly string[] }): boolean {
  if (path === item.href) return true;
  return (item.matches ?? []).some((prefix) => path === prefix || path.startsWith(prefix + '/'));
}

/*
  The drawer repeats the header's call to action as a full-width button at the
  end, so Visit is dropped from the list itself: three copies of the same link
  on one panel is noise.
*/
const drawerLinks = FOOTER_LINKS.filter((item) => item.href !== cta.href);
---

<header
  class="site-header fixed inset-x-0 top-0 z-50 border-b border-ink/10 bg-white/95 backdrop-blur [view-transition-name:site-header]"
>
  {/* Full width, not the 1080px content column: with nine links plus the
      button the wordmark and the nav were nearly touching. */}
  <div class="flex h-[76px] items-center justify-between gap-8 px-gutter">
    <a href="/" class="flex items-center gap-3" aria-label="Quest Laguna, home">
      <img src="/images/logo-mark.png" alt="" width="40" height="40" class="rounded-full" />
      <span class="font-display text-lg leading-tight font-semibold">
        Quest
        <span class="block font-sans text-[10px] font-bold tracking-[0.3em] text-maroon">
          LAGUNA
        </span>
      </span>
    </a>

    {/* Nine links plus the button fit beside the wordmark from lg up; tablets
        and phones use the drawer, which carries every page. The current page
        gets a brand underline, not a colour-only cue. */}
    <nav class="hidden items-center gap-4 lg:flex xl:gap-6" aria-label="Main">
      {
        links.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item) ? 'page' : undefined}
            class:list={[
              'relative py-1 text-small font-semibold whitespace-nowrap transition-colors duration-200',
              'after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:bg-brand after:opacity-0 after:transition-opacity after:duration-200',
              isCurrent(item) ? 'text-ink after:opacity-100' : 'text-ink/65 hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <Button href={cta.href} size="sm" class="ml-1">{cta.label}</Button>
    </nav>

    {/* Mobile: the one call to action stays in the bar beside the toggle,
        because most visitors never open the menu. */}
    <div class="flex items-center gap-1.5 lg:hidden">
      <Button href={cta.href} size="sm">{cta.label}</Button>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-11 w-11 items-center justify-center rounded-btn text-ink"
      >
        <span class="sr-only">Toggle menu</span>
        <svg
          data-icon-open
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          data-icon-close
          class="hidden"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

{/* Full-height sheet below the fixed bar. Deliberately a SIBLING of the
    header, not a child: the header's `backdrop-blur` makes it the containing
    block for position:fixed descendants, so nested inside it the sheet
    measured `top-[76px] bottom-0` against a 76px-tall header and rendered with
    no height at all. It also needs its own z-index out here: inside the header
    it sat in that element's z-50 stacking context, and as a sibling with
    z-auto the positioned page sections painted straight over it. The list
    scrolls, so a long list stays reachable on a short screen, and the page
    behind is scroll-locked so a swipe moves the menu. */}
<nav
  id="mobile-menu"
  hidden
  class="fixed inset-x-0 top-[76px] bottom-0 z-40 overflow-y-auto overscroll-contain border-t border-ink/10 bg-white px-gutter pt-2 pb-8 transition-[opacity,translate] duration-200 ease-swift lg:hidden starting:-translate-y-2 starting:opacity-0"
  aria-label="All pages"
>
  {
    drawerLinks.map((item) => (
      <a
        href={item.href}
        aria-current={path === item.href ? 'page' : undefined}
        class:list={[
          'block border-b border-ink/5 py-3.5 text-title-sm font-semibold',
          path === item.href ? 'text-brand' : 'text-ink/75',
        ]}
      >
        {item.label}
      </a>
    ))
  }
  <Button href={cta.href} class="mt-4 w-full">{cta.label}</Button>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = toggle?.querySelector<SVGElement>('[data-icon-open]');
  const iconClose = toggle?.querySelector<SVGElement>('[data-icon-close]');
  const desktop = window.matchMedia('(min-width: 64rem)');

  function setOpen(open: boolean) {
    if (!menu || !toggle || !iconOpen || !iconClose) return;
    menu.hidden = !open;
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    // Locks the page behind the sheet, so a swipe scrolls the menu itself.
    document.documentElement.classList.toggle('menu-open', open);
  }

  toggle?.addEventListener('click', () => setOpen(Boolean(menu?.hidden)));

  // Escape closes and hands focus back to the control that opened it.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || menu?.hidden !== false) return;
    setOpen(false);
    toggle?.focus();
  });

  // Following a link, or crossing into the desktop layout, must not leave the
  // sheet open or the scroll lock stuck on.
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });
  desktop.addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });
</script>
