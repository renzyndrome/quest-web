---
/*
  Pastoral services.

  Deliberately outside the header nav: that row is already nine items and
  starts colliding with the wordmark at lg. This page is reached from the
  mobile menu, the footer, the /ministries closing CTA, and /connect.

  Coordinators appear by FIRST NAME only. No phone numbers, no email addresses,
  no handles — that is member PII (.claude/rules/content.md). Every card sends
  the visitor to the question form on /connect, which emails the church office
  to forward on.
*/
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import PillButton from '../components/PillButton.astro';
import { PASTORAL_SERVICES } from '../lib/site';
import { PASTORAL_TOPIC } from '../lib/question';

const askHref = `/connect?topic=${encodeURIComponent(PASTORAL_TOPIC)}#ask`;
---

<Base
  title="Pastoral services — Quest Laguna"
  description="Dedications, weddings, funerals, counseling, and baptism at Quest Laguna Church. Ask about any of them here."
>
  <HeroBanner
    eyebrow="Pastoral care"
    title="Pastoral services."
    body="Dedications, weddings, funerals, counseling, and baptism. Each one is cared for by someone on our pastoral team, and you can ask about any of them here."
    compact
  />

  <section class="px-5 py-12 md:px-10 md:pb-20" aria-label="Our pastoral services">
    <div class="reveal mx-auto max-w-[1080px]">
      <h2 class="max-w-2xl text-3xl leading-[1.15] md:text-4xl">
        What we offer, and who to ask.
      </h2>
      {/* Equal-width cards throughout. An earlier version let the last card
          span two columns to avoid an orphan row, but that stretched its photo
          wide and object-cover then cropped the group out of it. */}
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          PASTORAL_SERVICES.map((service) => (
            <article class="flex flex-col rounded-card bg-cream px-8 py-9">
              {/* Every card carries a photo. Four are still labelled
                  placeholders until the church supplies real ones. */}
              <PhotoSlot
                label={service.photo.label}
                src={service.photo.src}
                alt={service.photo.alt}
                width={service.photo.width}
                height={service.photo.height}
                class="h-[160px] w-full"
              />
              <div class="mt-6 h-[3px] w-[34px] rounded bg-brand" aria-hidden="true" />
              <h3 class="mt-4 text-xl">{service.name}</h3>
              <p class="mt-2.5 text-sm leading-[1.7] text-ink/65">{service.blurb}</p>
              {/* mt-auto sits here, not on the button, so the coordinator line
                  and the button travel together as one bottom block. */}
              <p class="mt-auto pt-5 text-sm text-ink/75">
                Cared for by <span class="font-semibold text-ink">{service.coordinatorFirstName}</span>
              </p>
              <div class="mt-4">
                <PillButton href={`/connect?service=${service.slug}#ask`} size="sm">
                  Ask about this<span class="sr-only"> {service.name}</span>
                </PillButton>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-cream px-5 py-16 md:px-10 md:py-20" aria-label="Get in touch">
    <div class="mx-auto max-w-[640px] text-center">
      <h2 class="text-2xl md:text-3xl">Not sure who to talk to?</h2>
      <p class="mt-3 text-[15px] leading-[1.7] text-ink/65">
        Ask anyway. Tell us what is happening and we will point you to the right person.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-4">
        <PillButton href={askHref}>Ask a question</PillButton>
        <PillButton href="/visit" variant="outline">Plan a visit</PillButton>
      </div>
    </div>
  </section>
</Base>
