---
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Chip from '../components/Chip.astro';
import { FIRST_VISIT, GATHERINGS, MAIN_LOCATION, SATELLITES } from '../lib/site';

// The landing page for the sitewide Visit button. Everything a first-time
// guest needs on one page: when we gather, where to find us, and what to
// expect. Contact forms stay on /connect.

// Keyless Google Maps search, loaded on tap by MapEmbed — the raw embed is
// ~1.7 MB of Google JavaScript, four times the rest of this page.
const MAP_QUERY = 'Quest Laguna Biñan';

/*
  The three things a visitor asks before a first Sunday. The wording comes from
  FIRST_VISIT in site.ts, which the Connect FAQ reads too, so the two pages can
  never answer the same question differently again.
*/
const expectations = [
  {
    title: 'No dress code',
    body: `${FIRST_VISIT.dressCode} ${FIRST_VISIT.length}`,
    photo: null,
  },
  {
    title: 'A welcome at the door',
    body: FIRST_VISIT.welcome,
    photo: {
      src: '/images/site/ministry-ushering.webp',
      alt: 'The Guest Experience Ministry team welcoming guests',
    },
  },
  {
    title: "Children's church",
    body: FIRST_VISIT.kids,
    photo: {
      src: '/images/site/ministry-kids.webp',
      alt: 'The NXTGN Kids Ministry team with the children',
    },
  },
];
---

<Base
  title="Plan a visit | Quest Laguna"
  description="Plan your first visit to Quest Laguna Church: gathering times, our locations across Laguna and Cavite, directions to Biñan City, and what to expect on a Sunday."
>
  <HeroBanner
    variant="photo"
    eyebrow="Plan a visit"
    title="Your first visit."
    body="When we gather, where to find us, and what to expect."
    image="/images/site/worship-hands.webp"
    imageAlt=""
  />

  <section class="px-gutter py-section" aria-label="When we gather">
    <div class="mx-auto max-w-narrow">
      <SectionHeading
        title="When we gather."
        body="Family Reunion on Sunday morning is the main gathering and a good first visit. The other gatherings run through the week."
      />
      {/* Rows stack on phones (side by side only from md) so every row reads
          the same regardless of how short its subtitle is. */}
      <ul class="mt-8 divide-y divide-ink/10 border-y border-ink/10">
        {
          GATHERINGS.map((gathering) => (
            <li class="flex flex-col gap-1 py-5 md:flex-row md:items-baseline md:justify-between md:gap-x-8">
              <div>
                <h3 class="flex flex-wrap items-center gap-2 text-title">
                  {gathering.name}
                  {gathering.online && <Chip variant="tint">Online</Chip>}
                </h3>
                <p class="mt-0.5 text-body-sm text-ink/60">{gathering.subtitle}</p>
              </div>
              <p class="text-micro font-bold tracking-[0.12em] whitespace-nowrap text-maroon uppercase">
                {gathering.schedule}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-cream px-gutter py-section" aria-label="Where to find us">
    <div class="mx-auto grid max-w-content gap-10 md:grid-cols-[1.2fr_1fr] md:items-start">
      <div>
        <SectionHeading
          title="Where to find us."
          body={`The main mission point is ${MAIN_LOCATION.name} on ${MAIN_LOCATION.address}. The map below has directions.`}
        />
        <MapEmbed
          query={MAP_QUERY}
          address={MAIN_LOCATION.address ?? ''}
          height={340}
          class="mt-6"
        />
      </div>
      <div>
        <h3 class="text-title-lg">Our satellite churches</h3>
        <p class="mt-2 text-body-sm text-ink/60">
          Across Laguna, Cavite, and one in Hungary. Message us on Facebook for the meeting place
          and schedule of any location.
        </p>
        <ul class="mt-5 grid grid-cols-2 gap-x-6 gap-y-3">
          {
            SATELLITES.map((location) => (
              <li class="text-body-sm text-ink/75">
                {location.name}
                {location.area && <span class="block text-micro text-ink/45">{location.area}</span>}
              </li>
            ))
          }
        </ul>
        <a
          href="/#locations"
          class="mt-5 inline-flex min-h-11 items-center text-small font-semibold text-maroon underline underline-offset-4"
        >
          See every location
        </a>
      </div>
    </div>
  </section>

  <section class="px-gutter py-section" aria-label="What to expect">
    <div class="mx-auto max-w-content">
      <SectionHeading title="What to expect." />
      <div class="mt-10 grid gap-8 md:grid-cols-3 md:gap-10">
        {
          expectations.map((item) => (
            <article>
              {item.photo ? (
                <img
                  src={item.photo.src}
                  alt={item.photo.alt}
                  width={900}
                  height={600}
                  loading="lazy"
                  decoding="async"
                  class="mb-5 aspect-[3/2] w-full rounded-tile object-cover"
                />
              ) : (
                <div class="mb-5 h-[3px] w-[34px] rounded bg-brand" aria-hidden="true" />
              )}
              <h3 class="text-title-lg">{item.title}</h3>
              <p class="mt-2.5 text-body text-ink/65">{item.body}</p>
            </article>
          ))
        }
      </div>
      {/* One closing sentence rather than another band: the footer's scripture
          already ends the page. */}
      <p class="mt-12 max-w-narrow text-body text-ink/65">
        Questions before a visit can go through the <a
          href="/connect"
          class="font-semibold text-maroon underline underline-offset-4">Connect page</a
        > or by <a
          href="https://facebook.com/questlaguna"
          rel="noopener"
          class="font-semibold text-maroon underline underline-offset-4">Facebook message</a
        >.
      </p>
    </div>
  </section>
</Base>
