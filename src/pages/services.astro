---
/*
  Booking and assisting for pastoral services and rites.

  Deliberately outside the header nav: that row is already nine items and
  starts colliding with the wordmark at lg. Reached from the mobile menu, the
  footer, the /ministries closing CTA, and /connect.

  Admins appear by FIRST NAME only. No phone numbers, no email addresses, no
  handles — that is member PII (.claude/rules/content.md). Every card sends the
  visitor to the question form on /connect, which emails the office to pass on.

  Spacing is tuned for a phone: most of this church's traffic is mid-range
  Android, and five stacked cards get tall fast. Padding and the photo box both
  step up at sm rather than starting large.
*/
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import PillButton from '../components/PillButton.astro';
import { PASTORAL_SERVICES } from '../lib/site';
import { PASTORAL_TOPIC } from '../lib/question';

const askHref = `/connect?topic=${encodeURIComponent(PASTORAL_TOPIC)}#ask`;
---

<Base
  title="Pastoral services and rites — Quest Laguna"
  description="Booking and assisting for dedications, weddings, funerals, counseling, baptism and communion at Quest Laguna Church."
>
  <HeroBanner
    eyebrow="Booking and assisting"
    title="Pastoral services and rites."
    body="Each one has an admin who helps you book it. Send a message and they will get back to you."
    compact
  />

  <section class="px-5 pb-14 md:px-10 md:pb-20" aria-label="Pastoral services and rites">
    <div class="reveal mx-auto max-w-[1080px]">
      <h2 class="text-2xl leading-[1.15] md:text-3xl">Who to ask.</h2>

      {/* Equal-width cards throughout. An earlier version let the last card
          span two columns to avoid an orphan row, but that stretched its photo
          wide and object-cover then cropped the group out of it. */}
      <div class="mt-6 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
        {
          PASTORAL_SERVICES.map((service) => (
            <article class="flex flex-col rounded-card bg-cream px-6 py-6 sm:px-8 sm:py-8">
              {/* Every card carries a photo. Four are still labelled
                  placeholders until the church supplies real ones. */}
              <PhotoSlot
                label={service.photo.label}
                src={service.photo.src}
                alt={service.photo.alt}
                width={service.photo.width}
                height={service.photo.height}
                class="h-[110px] w-full sm:h-[150px]"
              />
              <div class="mt-5 h-[3px] w-[34px] rounded bg-brand" aria-hidden="true" />
              <h3 class="mt-3 text-lg leading-snug">{service.name}</h3>
              {/* mt-auto sits here, not on the button, so the admin line and
                  the button travel together as one bottom block. */}
              <p class="mt-auto pt-4 text-sm text-ink/75">
                Admin: <span class="font-semibold text-ink">{service.adminFirstName}</span>
              </p>
              <div class="mt-3">
                <PillButton href={`/connect?service=${service.slug}#ask`} size="sm">
                  Ask about this<span class="sr-only"> {service.name}</span>
                </PillButton>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-cream px-5 py-12 md:px-10 md:py-16" aria-label="Get in touch">
    <div class="mx-auto max-w-[640px] text-center">
      <h2 class="text-2xl md:text-3xl">Not sure who to ask?</h2>
      <p class="mt-3 text-[15px] leading-[1.7] text-ink/65">
        Send a message anyway. We will pass it to the right admin.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <PillButton href={askHref}>Send a message</PillButton>
        <PillButton href="/visit" variant="outline">Plan a visit</PillButton>
      </div>
    </div>
  </section>
</Base>
