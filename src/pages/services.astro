---
/*
  Booking and assisting for pastoral services and rites.

  Deliberately outside the header nav, which is already full. Reached from the
  mobile drawer, the footer, the /ministries closing band, and /connect.

  Admins appear by FIRST NAME only. No phone numbers, no email addresses, no
  handles — that is member PII (.claude/rules/content.md). Every row sends the
  visitor to the question form on /connect, which emails the office to pass on.
*/
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import { PASTORAL_SERVICES } from '../lib/site';
import { PASTORAL_TOPIC } from '../lib/question';

const askHref = `/connect?topic=${encodeURIComponent(PASTORAL_TOPIC)}#ask`;
---

<Base
  title="Pastoral services and rites | Quest Laguna"
  description="Booking and assisting for dedications, weddings, funerals, counseling, baptism and communion at Quest Laguna Church."
>
  <HeroBanner
    eyebrow="Pastoral services"
    title="Pastoral services and rites."
    body="Each service has an admin. Bookings start with a message through the question form."
  >
    <img
      slot="aside"
      src="/images/site/worship.webp"
      alt="Congregation with hands raised during Sunday worship"
      width={900}
      height={718}
      class="h-auto w-full rounded-media shadow-media"
    />
  </HeroBanner>

  <section class="px-gutter py-section" aria-label="Pastoral services and rites">
    <div class="mx-auto max-w-content">
      <SectionHeading title="Who to ask." />

      {/* Equal-width cards. A card whose photo has not arrived yet is simply
          text; a dashed "photo coming" box told the visitor nothing useful. */}
      <div class="mt-8 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
        {
          PASTORAL_SERVICES.map((service) => (
            <article class="flex flex-col rounded-card bg-cream px-6 py-6 sm:px-8 sm:py-8">
              {service.photo && (
                <img
                  src={service.photo.src}
                  alt={service.photo.alt}
                  width={service.photo.width}
                  height={service.photo.height}
                  loading="lazy"
                  decoding="async"
                  class="h-[150px] w-full rounded-media object-cover sm:h-[170px]"
                />
              )}
              <div class:list={['h-[3px] w-[34px] rounded bg-brand', service.photo && 'mt-5']} aria-hidden="true" />
              <h3 class="mt-3 text-title leading-snug">{service.name}</h3>
              {/* mt-auto sits here, not on the button, so the admin line and
                  the button travel together as one bottom block. */}
              <p class="mt-auto pt-4 text-body-sm text-ink/75">
                Admin: <span class="font-semibold text-ink">{service.adminFirstName}</span>
              </p>
              <div class="mt-3">
                <Button href={`/connect?service=${service.slug}#ask`} size="sm">
                  Ask about this<span class="sr-only"> {service.name}</span>
                </Button>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-cream px-gutter py-section" aria-label="Other requests">
    <div class="mx-auto max-w-copy">
      <h2 class="text-title-lg">Other requests.</h2>
      <p class="mt-3 text-body text-ink/65">
        Requests that do not fit a service above can be sent through the same form. The office
        passes them on.
      </p>
      <div class="mt-7 flex flex-wrap gap-4">
        <Button href={askHref}>Send a message</Button>
        <Button href="/visit" variant="outline">Plan a visit</Button>
      </div>
    </div>
  </section>
</Base>
