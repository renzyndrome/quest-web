---
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import PillButton from '../components/PillButton.astro';
import ScriptureLine from '../components/ScriptureLine.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Chip from '../components/Chip.astro';

// Giving methods per client direction: GCash QR code + in person only.
// The QR code image is CLIENT-SUPPLIED — the dashed box below is an
// intentional placeholder; never invent financial details.

// Where giving goes — the church's giving focus areas, shown for transparency.
// Informational only: giving is not earmarked online (GCash / in person),
// this simply shows what the church supports. Static for now (edited here);
// can move to a CMS collection later if marketing needs to self-serve.
// Copy is intentionally non-specific — never invent amounts, dates, or goals.
const givingFocus = [
  {
    title: 'Outreach program',
    body: 'Feeding, relief, and community programs that bring real help and the hope of Jesus to neighborhoods around every location.',
  },
  {
    title: 'Church planting',
    body: 'Starting new Quest congregations so more towns across Laguna have a church family within reach.',
  },
  {
    title: 'Soul-winning',
    tag: 'Hayo',
    body: 'Our Hayo teams go out house to house and street to street, sharing the gospel and inviting people to belong.',
  },
  {
    title: 'Local & international missions',
    tag: 'Coming soon',
    body: 'Sending and supporting teams that carry the gospel beyond Laguna, and one day beyond the Philippines.',
  },
  {
    title: 'Land acquisition',
    tag: 'Ongoing',
    body: 'Securing permanent homes for our locations so we can gather, grow, and serve for years to come.',
  },
  {
    title: 'Missionaries & volunteers',
    body: 'Supporting the workers who serve full-time, so they can give themselves fully to the ministry.',
  },
  {
    title: 'Scholarsheep sponsors',
    body: 'Helping students in our church family stay in school through sponsored scholarships.',
  },
  {
    title: 'Ministry needs',
    tag: 'Open requests',
    body: 'Specific tools and needs our ministries are raising support for this season.',
    href: '/ministries',
  },
];
---

<Base title="Give — Quest Laguna">
  <HeroBanner
    eyebrow="Give"
    title="Giving is part of how we worship."
    body="Your tithes and offerings keep the church running, support our pastors and workers, and help us reach more communities across Laguna. Give freely and cheerfully, not out of pressure."
    compact
  />

  <section class="px-5 pb-12 md:px-10" aria-label="Scripture">
    <ScriptureLine reference="2 Corinthians 9:7">
      Each of you should give what you have decided in your heart to give, not reluctantly or under
      compulsion, for God loves a cheerful giver.
    </ScriptureLine>
  </section>

  <section class="px-5 pb-16 md:px-10 md:pb-20" aria-label="Ways to give">
    <div class="mx-auto grid max-w-[820px] gap-6 md:grid-cols-2">
      <article class="rounded-card bg-cream px-8 py-9">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-brand text-white">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
            <path d="M14 14h3v3h-3zM21 14v.01M14 21v.01M21 21v.01M17.5 17.5h.01"></path>
          </svg>
        </div>
        <h2 class="mt-5 text-lg">GCash</h2>
        <p class="mt-2 text-sm leading-[1.7] text-ink/65">
          Scan the QR code with your GCash app to give from anywhere.
        </p>
        <div class="mt-4 flex aspect-square max-w-[220px] items-center justify-center rounded-xl border border-dashed border-maroon/35 px-4 py-5 text-center text-sm font-semibold text-maroon">
          GCash QR code to be added here
        </div>
      </article>

      <article class="rounded-card bg-cream px-8 py-9">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-brand text-white">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <h2 class="mt-5 text-lg">In person</h2>
        <p class="mt-2 text-sm leading-[1.7] text-ink/65">
          Give during any of our services at your location. Envelopes are available from the
          ushers.
        </p>
        {/* Handoff copy — keep in sync with SERVICES in src/lib/sample-content.ts */}
        <p class="mt-4 text-xs font-bold tracking-[0.12em] text-maroon uppercase">
          Sundays 10 AM · Fridays 7 PM · Saturdays 5 AM & 3 PM
        </p>
      </article>
    </div>
  </section>

  <section class="bg-cream px-5 py-16 md:px-10 md:py-24" aria-label="Where your giving goes">
    <div class="mx-auto max-w-[1080px]">
      <div class="max-w-2xl">
        <Eyebrow>Where your giving goes</Eyebrow>
        <h2 class="mt-4 text-2xl md:text-3xl">Every gift is at work in the harvest.</h2>
        <p class="mt-4 text-[15px] leading-[1.7] text-ink/65">
          Your giving keeps the weekly services running at all nine locations and supports our
          pastors and full-time workers. Beyond that, here is what your generosity is building
          across Laguna and beyond.
        </p>
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-3">
        <PhotoSlot label="Outreach team serving a community" class="h-[200px] w-full md:h-[240px]" />
        <PhotoSlot label="Church planting team at a new location" class="h-[200px] w-full md:h-[240px]" />
        <PhotoSlot label="Volunteers on a soul-winning walk" class="h-[200px] w-full md:h-[240px]" />
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          givingFocus.map((focus) => (
            <article class="flex flex-col rounded-card bg-white px-7 py-8 shadow-card">
              <div class="flex items-center gap-3">
                <span class="h-[3px] w-[34px] rounded bg-brand" aria-hidden="true" />
                {focus.tag && <Chip variant="tint">{focus.tag}</Chip>}
              </div>
              <h3 class="mt-4 text-lg">{focus.title}</h3>
              <p class="mt-2.5 text-sm leading-[1.7] text-ink/65">{focus.body}</p>
              {focus.href && (
                <a
                  href={focus.href}
                  class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-maroon underline underline-offset-4"
                >
                  See current needs
                </a>
              )}
            </article>
          ))
        }
      </div>

      <div class="mt-12 rounded-card border border-dashed border-maroon/35 px-7 py-8 text-center">
        <p class="mx-auto max-w-xl text-[15px] leading-[1.7] text-ink/70">
          Want to give toward a specific cause, or have questions about where your giving goes? Ask
          our Admin and Finance team any Sunday, or send us a message.
        </p>
        <div class="mt-6 flex justify-center">
          <PillButton href="/connect" variant="outline">Ask a question</PillButton>
        </div>
      </div>
    </div>
  </section>
</Base>
