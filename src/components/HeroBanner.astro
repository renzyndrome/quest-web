---
/*
  The page hero, in four surfaces rather than one. Which surface a page uses is
  an editorial choice, so consecutive pages do not open identically:

    photo  full-bleed photograph under one bottom-weighted scrim
    dark   red-to-black gradient with paper grain
    red    red radial gradient with paper grain
    cream  warm flat cream, optionally with a photo column in the `aside` slot

  pt clears the fixed 76px header. Content is bottom-left over a photo and
  top-left everywhere else; nothing here is ever centred.
*/
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow: string;
  title: string;
  body?: string;
  variant?: 'photo' | 'dark' | 'red' | 'cream';
  image?: string | null;
  imageSrcset?: string;
  imageAlt?: string;
}
const {
  eyebrow,
  title,
  body,
  variant = 'cream',
  image = null,
  imageSrcset,
  imageAlt = '',
} = Astro.props;

const isPhoto = variant === 'photo' && Boolean(image);
const onDark = isPhoto || variant === 'dark' || variant === 'red';
const hasAside = Astro.slots.has('aside');

const surfaces = {
  photo: '',
  dark: 'bg-black-red grain text-white',
  red: 'bg-red-radial grain text-white',
  cream: 'bg-cream border-b border-cream-200',
};
---

<section class:list={['relative isolate overflow-hidden', surfaces[isPhoto ? 'photo' : variant]]}>
  {
    isPhoto && (
      <>
        <img
          src={image}
          srcset={imageSrcset}
          sizes={imageSrcset ? '100vw' : undefined}
          alt={imageAlt}
          width="1600"
          height="900"
          class="absolute inset-0 -z-20 h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        {/* One scrim, weighted to the bottom where the copy sits. The campaign
            banner carries its own typography, so the base has to go properly
            dark for the headline to hold. */}
        <div class="absolute inset-0 -z-10 bg-scrim-b" aria-hidden="true" />
      </>
    )
  }

  {/* Outer padding, inner max-width: the same nesting every section uses, so
      the hero headline lands on the identical vertical rule as the content
      below it rather than 40px inside it. */}
  <div
    class:list={[
      'px-gutter',
      isPhoto
        ? // Inherited text-shadow keeps the whole stack readable over artwork.
          'flex min-h-[68dvh] flex-col justify-end pt-[120px] pb-14 [text-shadow:0_2px_24px_rgba(20,19,21,0.55)] md:min-h-[76dvh] md:pb-20'
        : 'pt-[116px] pb-12 md:pt-[140px] md:pb-16',
    ]}
  >
    <div
      class:list={[
        'mx-auto w-full max-w-content',
        hasAside && !isPhoto ? 'grid items-center gap-8 md:grid-cols-[1.2fr_1fr]' : '',
      ]}
    >
      <div class="flex flex-col items-start text-left">
        <Eyebrow onDark={onDark}>{eyebrow}</Eyebrow>
        <h1
          class:list={[
            'display mt-4 max-w-3xl',
            isPhoto ? 'text-display-xl' : 'text-display-lg',
            onDark ? 'text-white' : 'text-ink',
          ]}
        >
          {title}
        </h1>
        {
          body && (
            <p
              class:list={[
                'mt-5 max-w-2xl text-body-lg',
                onDark ? 'text-white/85' : 'text-ink/65',
              ]}
            >
              {body}
            </p>
          )
        }
        {
          Astro.slots.has('default') && (
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <slot />
            </div>
          )
        }
      </div>
      {hasAside && !isPhoto && <slot name="aside" />}
    </div>
  </div>
</section>
