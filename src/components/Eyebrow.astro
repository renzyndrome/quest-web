---
interface Props {
  onDark?: boolean;
}
const { onDark = false } = Astro.props;
---

<p
  class:list={[
    'flex items-center gap-2 text-xs font-bold tracking-[0.2em] uppercase',
    onDark ? 'text-red-soft' : 'text-maroon',
  ]}
>
  <span aria-hidden="true" class="tracking-tighter">›››</span>
  <slot />
</p>
