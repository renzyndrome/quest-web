---
import PhotoSlot from './PhotoSlot.astro';
import PillButton from './PillButton.astro';
import { formatEventDate, formatEventTime, type ChurchEvent } from '../lib/events';

interface Props {
  event: ChurchEvent;
}
const { event } = Astro.props;
const time = formatEventTime(event.time);
---

<article class="overflow-hidden rounded-card border border-ink/5 bg-white shadow-card">
  {
    event.bannerUrl ? (
      <img
        src={event.bannerUrl}
        alt={event.bannerAlt ?? ''}
        loading="lazy"
        width="400"
        height="140"
        class="h-[140px] w-full object-cover"
      />
    ) : (
      <div class="px-4 pt-4">
        <PhotoSlot label={`Banner photo for ${event.name}`} class="h-[130px] w-full" />
      </div>
    )
  }
  <div class="p-6">
    <span
      class:list={[
        'inline-block rounded-full px-3 py-1 text-[10px] font-bold tracking-widest uppercase',
        event.registrationOpen ? 'bg-red-tint text-maroon' : 'bg-cream text-ink/60',
      ]}
    >
      {event.registrationOpen ? 'Registration open' : 'Upcoming event'}
    </span>
    <p class="mt-3 text-xs font-bold tracking-[0.12em] text-maroon uppercase">
      {formatEventDate(event.date)}{time && ` · ${time}`}
    </p>
    <h3 class="mt-2 text-lg">
      <a
        href={`/events/${event.slug}`}
        class="transition-colors duration-200 hover:text-maroon"
      >
        {event.name}
      </a>
    </h3>
    {event.venue && <p class="mt-1 text-sm text-ink/60">{event.venue}</p>}
    {
      event.registrationUrl ? (
        <div class="mt-4">
          <PillButton href={event.registrationUrl} size="sm">
            Register
          </PillButton>
        </div>
      ) : (
        <a
          href={`/events/${event.slug}`}
          class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-maroon underline underline-offset-4"
        >
          View details
        </a>
      )
    }
  </div>
</article>
