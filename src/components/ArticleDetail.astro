---
/*
  Shared announcement/news detail body. Rendered by both the static detail
  page (src/pages/news/[slug].astro) and the on-demand draft preview route
  (src/pages/news/preview/[slug].astro) so published and preview views stay
  identical.
*/
import DetailHeader from './DetailHeader.astro';
import Chip from './Chip.astro';
import { type Announcement } from '../lib/cms';

interface Props {
  announcement: Announcement;
}
const { announcement } = Astro.props;
const longDate = new Date(announcement.date).toLocaleDateString('en-PH', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
// Already a sized (banner preset) URL resolved by the CMS fetcher.
const bannerSrc = announcement.banner;
---

<DetailHeader backHref="/news" backLabel="All news" title={announcement.title}>
  <Fragment slot="chips">
    <Chip>{announcement.category}</Chip>
    <span class="text-small text-ink/55">{longDate}</span>
  </Fragment>
</DetailHeader>

<section class="px-gutter py-section" aria-label="Announcement">
  <div class="mx-auto max-w-narrow">
    {/* No banner means no image block. A dashed placeholder in a published
        article tells the reader nothing they need. */}
    {
      bannerSrc && (
        <img
          src={bannerSrc}
          alt={announcement.bannerAlt ?? ''}
          width="820"
          height="340"
          class="h-auto w-full rounded-media shadow-media"
        />
      )
    }

    {/*
      Trusted content: static build, published-only items from our own
      CMS (limited editor feature set, trusted staff, no user-generated
      content). If editor trust ever widens, add a build-time sanitize
      pass in the fetcher — see .claude/rules/content.md.
    */}
    <div class:list={['rich-text', bannerSrc ? 'mt-8' : '']} set:html={announcement.body} />

    <div class="mt-10 border-t border-ink/10 pt-6">
      <a
        href="/news"
        class="inline-flex min-h-11 items-center gap-1.5 text-small font-semibold text-maroon"
      >
        <span aria-hidden="true">&lsaquo;</span> Back to all news
      </a>
    </div>
  </div>
</section>
