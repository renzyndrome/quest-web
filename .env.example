# ── Site ────────────────────────────────────────────────────────────────
SITE_URL=https://questlaguna.org

# ── Directus CMS (all site content: announcements, slides, events) ─────
# Leave unset to build with the built-in sample content (src/lib/sample-content.ts).
# DIRECTUS_TOKEN: a read-only static token for a "site" role in Directus.
# For draft preview (below) to work, this token's role must also be able to
# read non-published (draft) announcements.
DIRECTUS_URL=
DIRECTUS_TOKEN=

# ── Draft preview (RUNTIME env — set on the site service, not build) ────
# Enables /news/preview/<slug>?token=<PREVIEW_SECRET> so editors can view an
# unpublished announcement live from Directus before publishing. Unset = the
# preview route is disabled and returns 404. Use a long random value.
PREVIEW_SECRET=

# ── Prayer form email (RUNTIME env — set on the site service, not build) ─
# Unset = the form falls back to the Facebook Messenger handoff (no email).
# When all three are set, requests are emailed to the prayer team.
# RESEND_API_KEY: from resend.com (free tier). PRAYER_FROM_EMAIL must be a
# verified sender domain in Resend (e.g. prayer@questlaguna.org).
RESEND_API_KEY=
PRAYER_TEAM_EMAIL=
PRAYER_FROM_EMAIL=

# ── Question form email (RUNTIME env — set on the site service, not build) ─
# The Connect page "Ask a question" form. Unset = it falls back to the same
# Facebook Messenger handoff. When both are set (plus RESEND_API_KEY above),
# questions are emailed to the church admin/office inbox — NOT the prayer team.
# QUESTION_FROM_EMAIL must be a verified sender domain in Resend.
QUESTION_TEAM_EMAIL=
QUESTION_FROM_EMAIL=

# ── YouTube Data API (BUILD-time — sermons archive) ────────────────────
# Unset = sermons archive uses sample entries. Key from Google Cloud console.
# Playlist IDs are per-service uploads playlists (see src/lib/youtube.ts).
YOUTUBE_API_KEY=
YOUTUBE_PLAYLIST_FAMILY=
YOUTUBE_PLAYLIST_YOUNGPRO=
YOUTUBE_PLAYLIST_YOUTH=
YOUTUBE_PLAYLIST_DAWN=
