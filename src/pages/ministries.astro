---
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import PillButton from '../components/PillButton.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import ScriptureLine from '../components/ScriptureLine.astro';

const areas = [
  {
    title: 'Worship & Creative',
    body: 'If you sing, play an instrument, dance, or love being behind a camera or a soundboard, this is your team.',
    teams: ['Praise & Worship', 'Dance', 'Media & Tech'],
  },
  {
    title: 'Teaching & Discipleship',
    body: 'Love the Word and love people? Help others grow, from new believers to future leaders.',
    teams: ['Preaching', 'Teaching', 'Pastoral Care'],
  },
  {
    title: 'Kids & Next Generation',
    body: 'Teach and care for the youngest members of the family, with Sunday classes by age group.',
    teams: ['Kids Ministry', 'Youth', 'Campus Harvest'],
  },
  {
    title: 'Prayer & Fellowship',
    body: "Intercede for the church and build up the men's and women's fellowships.",
    teams: ['Prayer Warriors', 'AHALTA (Men)', 'EBA (Women)'],
  },
  {
    title: 'Service & Operations',
    body: 'The quiet work that makes Sunday happen: welcoming people, meals, events, admin, and finances.',
    teams: ['Ushering', 'Kitchen', 'Events', 'Admin & Finance'],
  },
  {
    title: 'Outreach & Missions',
    body: 'Bring the gospel beyond our walls, from nearby communities to new church plants.',
    teams: ['Church Planting', 'Consolidations'],
  },
];
---

<Base title="Ministries — Quest Laguna">
  <HeroBanner
    eyebrow="Ministries"
    title="Whatever you're good at, God can use it."
    body="Maybe you sing. Maybe you cook, or fix things, or you're good with kids, cameras, or spreadsheets. Every gift has a place here. Serving is how we grow, and how the church keeps going week after week."
    compact
  />

  <section class="px-5 pb-4 md:px-10" aria-label="Scripture">
    <ScriptureLine reference="1 Peter 4:10">
      Each of you should use whatever gift you have received to serve others, as faithful stewards
      of God's grace.
    </ScriptureLine>
  </section>

  <section class="px-5 py-12 md:px-10" aria-label="Ministry photos">
    <div class="mx-auto grid max-w-[1080px] gap-4 md:grid-cols-[1.4fr_1fr_1fr]">
      <PhotoSlot
        label="Worship team leading on a Sunday"
        src="/images/site/ministry-worship.webp"
        alt="The Praise and Worship ministry team"
        width={900}
        height={506}
        class="h-[200px] w-full md:h-[260px]"
      />
      <PhotoSlot
        label="Volunteers serving behind the scenes"
        src="/images/site/ministry-serving.webp"
        alt="The BTS ministry team who serve behind the scenes"
        width={900}
        height={506}
        class="h-[200px] w-full md:h-[260px]"
      />
      <PhotoSlot
        label="Kids ministry class"
        src="/images/site/ministry-kids.webp"
        alt="The Kids ministry team"
        width={900}
        height={506}
        class="h-[200px] w-full md:h-[260px]"
      />
    </div>
  </section>

  <section class="px-5 pb-16 md:px-10 md:pb-20" aria-label="Ministry areas">
    <div class="mx-auto grid max-w-[1080px] gap-6 md:grid-cols-2">
      {
        areas.map((area) => (
          <article class="rounded-card bg-cream px-8 py-9">
            <div class="h-[3px] w-[34px] rounded bg-brand" aria-hidden="true" />
            <h2 class="mt-4 text-xl">{area.title}</h2>
            <p class="mt-2.5 text-sm leading-[1.7] text-ink/65">{area.body}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {area.teams.map((team) => (
                <span class="rounded-full border border-ink/10 bg-white px-3.5 py-2 text-xs font-semibold text-ink/70">
                  {team}
                </span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bg-cream px-5 py-16 md:px-10 md:py-20" aria-label="Get in touch">
    <div class="mx-auto max-w-[640px] text-center">
      <h2 class="text-2xl md:text-3xl">Not sure where you fit?</h2>
      <p class="mt-3 text-[15px] leading-[1.7] text-ink/65">
        That's okay. Talk to the pastor at your location, or send us a message and we'll help you
        find a team to try. You can always switch later.
      </p>
      <div class="mt-7 flex justify-center">
        <PillButton href="/connect">Get in touch</PillButton>
      </div>
    </div>
  </section>
</Base>
