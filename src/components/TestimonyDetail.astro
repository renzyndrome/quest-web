---
/*
  Shared life-testimony detail body. Rendered by both the static detail page
  (src/pages/testimonies/[slug].astro) and the on-demand draft preview route
  (src/pages/testimonies/preview/[slug].astro) so published and preview views
  stay identical — the same arrangement ArticleDetail uses for news.
*/
import PhotoSlot from './PhotoSlot.astro';
import Chip from './Chip.astro';
import VideoEmbed from './VideoEmbed.astro';
import type { Testimony } from '../lib/testimonies';

interface Props {
  testimony: Testimony;
}
const { testimony } = Astro.props;

const longDate = new Date(testimony.date).toLocaleDateString('en-PH', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<section class="relative isolate overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-cream to-white" aria-hidden="true"></div>
  <div class="mx-auto max-w-[820px] px-5 pt-[120px] pb-10 md:px-10 md:pt-[140px]">
    <a
      href="/testimonies"
      class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-maroon"
    >
      <span aria-hidden="true">‹</span> All testimonies
    </a>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <Chip>Testimony</Chip>
      <span class="text-sm text-ink/55">{longDate}</span>
    </div>
    <h1 class="mt-4 text-3xl leading-[1.15] md:text-5xl">{testimony.title}</h1>
    {/* "Shared by X" rather than "X's story" — the possessive reads badly on
        names already ending in s. */}
    {
      testimony.person && (
        <p class="mt-3 text-base font-semibold text-maroon">Shared by {testimony.person}</p>
      )
    }
  </div>
</section>

<section class="px-5 pb-16 md:px-10 md:pb-24" aria-label="Testimony">
  <div class="mx-auto max-w-[820px]">
    {/* The video leads when there is one — most testimonies are told on
        camera first and written up underneath. */}
    {
      testimony.video ? (
        <VideoEmbed video={testimony.video} />
      ) : testimony.banner ? (
        <img
          src={testimony.banner}
          alt={testimony.bannerAlt ?? ''}
          width="820"
          height="340"
          class="h-auto w-full rounded-media shadow-media"
        />
      ) : (
        <PhotoSlot
          label="Portrait of the person sharing their story"
          class="h-[200px] w-full md:h-[280px]"
        />
      )
    }

    {/*
      Trusted content: static build, published-only items from our own
      CMS (limited editor feature set, trusted staff, no user-generated
      content). If editor trust ever widens, add a build-time sanitize
      pass in the fetcher — see .claude/rules/content.md.
    */}
    <div class="rich-text mt-8" set:html={testimony.body} />

    <div class="mt-10 border-t border-ink/10 pt-6">
      <a
        href="/testimonies"
        class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-maroon"
      >
        <span aria-hidden="true">‹</span> Back to all testimonies
      </a>
    </div>
  </div>
</section>
