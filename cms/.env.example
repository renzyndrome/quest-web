# Directus CMS environment — set these in Dokploy (or copy to cms/.env for local).
# Generate secrets with: openssl rand -hex 32

DIRECTUS_SECRET=
DB_PASSWORD=
DB_USER=directus
DB_DATABASE=quest_content

# First-run admin account (change the password after first login)
ADMIN_EMAIL=admin@questlaguna.org
ADMIN_PASSWORD=

# Public URL Directus is served from (the Dokploy domain)
DIRECTUS_PUBLIC_URL=https://cms.questlaguna.org

# Allowed browser origin for API calls (the public site)
SITE_ORIGIN=https://questlaguna.org
