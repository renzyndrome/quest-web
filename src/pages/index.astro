---
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import EventsCarousel from '../components/EventsCarousel.astro';
import EventCard from '../components/EventCard.astro';
import Eyebrow from '../components/Eyebrow.astro';
import PillButton from '../components/PillButton.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import Chip from '../components/Chip.astro';
import { getCarouselSlides, getAnnouncements, excerpt, type CarouselSlide } from '../lib/cms';
import { getUpcomingEvents, formatEventDate } from '../lib/events';
import { GATHERINGS, IDENTITY, MISSION } from '../lib/site';

// Carousel = CMS-curated slides + upcoming registrable events from the
// directory app, so both marketing campaigns and real events show up.
const [cmsSlides, events, announcements] = await Promise.all([
  getCarouselSlides(),
  getUpcomingEvents(),
  getAnnouncements(),
]);

// Cap event slides so the carousel stays short even with a full events list.
const eventSlides: CarouselSlide[] = events.slice(0, 4).map((event) => ({
  id: `event-${event.id}`,
  title: event.name,
  subtitle: [formatEventDate(event.date), event.venue].filter(Boolean).join(' · '),
  chip: event.registrationOpen ? 'Registration open' : 'Upcoming event',
  theme: 'dark' as const,
  image: event.bannerUrl,
  href: `/events/${event.slug}`,
}));

const slides = [...cmsSlides, ...eventSlides];
const upcomingEvents = events.slice(0, 3);
const latestNews = announcements.slice(0, 3);

// Text-on-photo mosaic: one tall lead tile, two stacked beside it.
const lifeTiles = [
  {
    title: 'Worship',
    body: 'We gather every week to worship God together, in every location, in every season.',
    photo: 'Congregation worshiping, hands raised',
    src: '/images/site/worship.webp',
    alt: 'Congregation with hands raised during Sunday worship',
  },
  {
    title: 'Community',
    body: 'No one walks alone here. We eat together, pray together, and carry each other.',
    photo: 'Small group sharing a meal',
    src: '/images/site/community.webp',
    alt: 'Members sharing a meal together after service',
  },
  {
    title: 'Growth',
    body: 'From first visit to leadership, there is a next step for everyone.',
    photo: 'Discipleship class, people smiling',
    src: '/images/site/growth.webp',
    alt: 'Small group gathered for teaching at the Quest Laguna hall',
  },
];
const [leadTile, ...sideTiles] = lifeTiles;

function newsDateParts(iso: string) {
  const date = new Date(iso);
  return {
    day: date.toLocaleDateString('en-PH', { day: '2-digit' }),
    month: date.toLocaleDateString('en-PH', { month: 'short' }),
  };
}
---

<Base title="Quest Laguna — Welcome home.">
  <HeroBanner
    eyebrow="A church in Laguna, Philippines"
    title="Welcome home."
    body="A church family in Biñan City, with locations across Laguna, Cavite, and beyond. Come as you are."
    image="/images/campaign-banner.jpg"
    imageSrcset="/images/campaign-banner-800.jpg 800w, /images/campaign-banner.jpg 1400w"
    imageAlt="NEXTLEVEL Stronger 2026 campaign"
  >
    <PillButton href="/visit">Plan a visit</PillButton>
    <PillButton href="/sermons" variant="ghost-dark">Watch online</PillButton>
  </HeroBanner>

  <section class="px-5 pt-14 pb-4 md:px-10 md:pt-20" aria-label="Highlights">
    <EventsCarousel slides={slides} />
  </section>

  <section class="px-5 py-16 md:px-10 md:py-24" aria-label="About Quest">
    <div class="reveal mx-auto grid max-w-[1080px] items-center gap-10 md:grid-cols-[1fr_1.2fr]">
      <PhotoSlot
        label="Church family after Sunday service"
        src="/images/site/church-family.webp"
        alt="Quest Laguna members gathered together after a Sunday service"
        width={770}
        height={414}
        class="h-auto w-full"
      />
      <div>
        <h2 class="text-3xl leading-[1.15] md:text-4xl">Who we are.</h2>
        <p class="mt-4 text-[15px] leading-[1.7] text-ink/65">{MISSION.body}</p>
        <p class="mt-3 text-[15px] leading-[1.7] text-ink/65">
          We began as a church planting mission in Biñan City and were established in {
            IDENTITY.established
          }. Today we are one family in many places, and you are welcome to be part of it.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-5">
          <PillButton href="/about">Get to know us</PillButton>
          <a
            href="#visit"
            class="inline-flex min-h-11 items-center text-sm font-semibold text-maroon underline underline-offset-4"
          >
            See service times
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Life at Quest — text on photos, not text beside photos. One tall lead
      tile, two stacked tiles; a different layout family from every card grid
      elsewhere on the page. */}
  <section class="px-5 pb-16 md:px-10 md:pb-24" aria-label="Life at Quest">
    <div class="reveal mx-auto max-w-[1080px]">
      <h2 class="max-w-2xl text-3xl leading-[1.15] md:text-4xl">Life at Quest.</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-[1.35fr_1fr] md:grid-rows-2">
        <article class="group relative overflow-hidden rounded-media shadow-media md:row-span-2">
          <img
            src={leadTile.src}
            alt={leadTile.alt}
            width={900}
            height={718}
            loading="lazy"
            decoding="async"
            class="h-[300px] w-full object-cover transition-transform duration-700 ease-swift group-hover:scale-[1.03] md:h-full md:min-h-[420px]"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/25 to-transparent"
            aria-hidden="true"
          />
          <div class="absolute inset-x-0 bottom-0 p-6 md:p-8">
            <h3 class="text-2xl text-white">{leadTile.title}</h3>
            <p class="mt-1.5 max-w-md text-sm leading-[1.65] text-white/85">{leadTile.body}</p>
          </div>
        </article>
        {
          sideTiles.map((tile) => (
            <article class="group relative overflow-hidden rounded-media shadow-media">
              <img
                src={tile.src}
                alt={tile.alt}
                width={900}
                height={718}
                loading="lazy"
                decoding="async"
                class="h-[220px] w-full object-cover transition-transform duration-700 ease-swift group-hover:scale-[1.03] md:h-full md:min-h-[200px]"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/25 to-transparent"
                aria-hidden="true"
              />
              <div class="absolute inset-x-0 bottom-0 p-6">
                <h3 class="text-xl text-white">{tile.title}</h3>
                <p class="mt-1 max-w-md text-sm leading-[1.6] text-white/85">{tile.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="visit" class="bg-cream px-5 py-16 md:px-10 md:py-24" aria-label="Service times">
    <div class="reveal mx-auto max-w-[1080px]">
      <PhotoSlot
        label="Hands raised in worship on a Sunday"
        src="/images/site/worship-hands.webp"
        alt="Hands raised in worship, seen from the back of the congregation"
        width={1600}
        height={742}
        class="h-auto w-full"
      />
      <div class="mt-10 grid gap-10 md:grid-cols-[1fr_1.3fr] md:gap-14">
        <div>
          <Eyebrow>Visit us</Eyebrow>
          <h2 class="mt-3 text-3xl leading-[1.15] md:text-4xl">Our weekly gatherings.</h2>
          <p class="mt-4 text-[15px] leading-[1.7] text-ink/65">
            We gather all week long, in locations across Laguna, Cavite, and beyond. Come as you
            are. Someone will be glad to welcome you.
          </p>
          <div class="mt-7">
            <PillButton href="https://facebook.com/questlaguna">Message us on Facebook</PillButton>
          </div>
        </div>
        <ul class="divide-y divide-ink/10 border-t border-b border-ink/10">
          {
            GATHERINGS.map((gathering) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
                <div>
                  <h3 class="flex flex-wrap items-center gap-2 text-base">
                    {gathering.name}
                    {gathering.online && <Chip variant="tint">Online</Chip>}
                  </h3>
                  <p class="mt-0.5 text-sm text-ink/60">{gathering.subtitle}</p>
                </div>
                <p class="text-xs font-bold tracking-[0.12em] whitespace-nowrap text-maroon uppercase">
                  {gathering.schedule}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="px-5 py-16 md:px-10 md:py-24" aria-label="Upcoming events">
    <div class="reveal mx-auto max-w-[1080px]">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-3xl leading-[1.15] md:text-4xl">Upcoming events.</h2>
        <a
          href="/events"
          class="inline-flex min-h-11 items-center text-sm font-semibold text-maroon underline underline-offset-4"
        >
          See all events
        </a>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {upcomingEvents.map((event) => <EventCard event={event} />)}
      </div>
    </div>
  </section>

  <section class="bg-cream px-5 py-16 md:px-10 md:py-24" aria-label="Latest news">
    <div class="reveal mx-auto max-w-[1080px]">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-3xl leading-[1.15] md:text-4xl">News and announcements.</h2>
        <a
          href="/news"
          class="inline-flex min-h-11 items-center text-sm font-semibold text-maroon underline underline-offset-4"
        >
          See all news
        </a>
      </div>
      <div class="mt-6 space-y-0">
        {
          latestNews.map((item) => {
            const { day, month } = newsDateParts(item.date);
            return (
              <article class="flex gap-5 border-b border-ink/10 py-6">
                <div class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-xl bg-white">
                  <span class="font-display text-[22px] leading-none font-semibold">{day}</span>
                  <span class="mt-0.5 text-[11px] font-bold tracking-widest text-maroon uppercase">
                    {month}
                  </span>
                </div>
                <div>
                  <Chip variant={item.pinned ? 'tint' : 'outline'}>
                    {item.pinned ? 'Pinned' : item.category}
                  </Chip>
                  <h3 class="mt-1.5 text-lg">
                    <a
                      href={`/news/${item.slug}`}
                      class="transition-colors duration-200 hover:text-maroon"
                    >
                      {item.title}
                    </a>
                  </h3>
                  <p class="mt-1 text-sm leading-[1.65] text-ink/65">{excerpt(item.body)}</p>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  {/* Closing invitation — the one full-bleed photo band on the page, and the
      only centered moment. */}
  <section class="relative isolate overflow-hidden" aria-label="You are invited">
    <img
      src="/images/site/praying.webp"
      alt=""
      width={900}
      height={718}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-b from-ink/70 via-maroon-deep/70 to-ink/80"
      aria-hidden="true"
    />
    <div
      class="mx-auto flex max-w-[720px] flex-col items-center px-5 py-20 text-center md:py-28"
    >
      <h2 class="text-3xl leading-[1.15] text-white md:text-5xl">You are welcome here.</h2>
      <p class="mt-4 max-w-lg text-[15px] leading-[1.7] text-white/85 md:text-base">
        Wherever you are in your journey, come and worship with us this Sunday, or send us a
        message first. We would love to meet you.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <PillButton href="/visit">Plan a visit</PillButton>
        <PillButton href="/about" variant="ghost-dark">Get to know us</PillButton>
      </div>
    </div>
  </section>
</Base>
