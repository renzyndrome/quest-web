# ── Site ────────────────────────────────────────────────────────────────
SITE_URL=https://questlaguna.org

# ── Directus CMS (marketing content) ───────────────────────────────────
# Leave unset to build with the built-in sample content (src/lib/sample-content.ts).
# DIRECTUS_TOKEN: a read-only static token for a "site" role in Directus.
DIRECTUS_URL=
DIRECTUS_TOKEN=

# ── Directory app events feed (read-only) ──────────────────────────────
# Public events endpoint exposed by the church admin app (TanStack Start).
# Leave unset to build with sample events.
EVENTS_API_URL=
