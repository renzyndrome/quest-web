---
/*
  One event in a grid. Without a banner the card leads with a date block rather
  than a placeholder box: the date is the most useful thing an event can show,
  and a dashed frame saying "banner photo" helps nobody.
*/
import Button from './Button.astro';
import { formatEventDate, formatEventTime, type ChurchEvent } from '../lib/events';

interface Props {
  event: ChurchEvent;
}
const { event } = Astro.props;
const time = formatEventTime(event.time);
const date = new Date(event.date);
const day = date.toLocaleDateString('en-PH', { day: '2-digit' });
const month = date.toLocaleDateString('en-PH', { month: 'short' });
---

<article
  class="flex flex-col overflow-hidden rounded-card border border-ink/10 bg-white transition-colors duration-200 ease-swift hover:border-brand/40"
>
  {
    event.bannerUrl ? (
      /*
        Fixed-height box + object-contain, not object-cover. Event banners are
        the church's Facebook posters, which are portrait (roughly 4:5) and
        carry all their information as text. Cropping them into a short
        landscape strip cut the title and the date straight off. The box still
        reserves its height, so nothing shifts while the image loads.
      */
      <div class="flex h-[280px] items-center justify-center border-b border-ink/10 bg-cream">
        <img
          src={event.bannerUrl}
          alt={event.bannerAlt ?? ''}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-contain"
        />
      </div>
    ) : (
      <div class="flex items-center gap-3 border-b border-ink/10 bg-cream px-6 py-4">
        <span class="display text-display-sm text-maroon tabular-nums">{day}</span>
        <span class="text-micro font-bold tracking-[0.2em] text-maroon uppercase">{month}</span>
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <span
      class:list={[
        'inline-block self-start rounded-full px-3 py-1 text-micro font-bold tracking-widest uppercase',
        event.registrationOpen ? 'bg-red-tint text-maroon' : 'bg-cream text-ink/60',
      ]}
    >
      {event.registrationOpen ? 'Registration open' : 'Upcoming event'}
    </span>
    <p class="mt-3 text-micro font-bold tracking-[0.12em] text-maroon uppercase">
      {formatEventDate(event.date)}{time && ` · ${time}`}
    </p>
    <h3 class="mt-2 text-title">
      <a href={`/events/${event.slug}`} class="transition-colors duration-200 hover:text-maroon">
        {event.name}
      </a>
    </h3>
    {event.venue && <p class="mt-1 text-body-sm text-ink/60">{event.venue}</p>}
    {
      event.registrationUrl ? (
        <div class="mt-auto pt-4">
          <Button href={event.registrationUrl} size="sm">
            Register
          </Button>
        </div>
      ) : (
        <a
          href={`/events/${event.slug}`}
          class="mt-auto inline-flex min-h-11 items-center self-start pt-3 text-small font-semibold text-maroon underline underline-offset-4"
        >
          Details
          <span class="sr-only"> about {event.name}</span>
        </a>
      )
    }
  </div>
</article>
