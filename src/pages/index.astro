---
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import EventsCarousel from '../components/EventsCarousel.astro';
import EventCard from '../components/EventCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import Chip from '../components/Chip.astro';
import ClosingBand from '../components/ClosingBand.astro';
import JourneySteps from '../components/JourneySteps.astro';
import { getCarouselSlides, getAnnouncements, excerpt, type CarouselSlide } from '../lib/cms';
import { getUpcomingEvents, formatEventDate } from '../lib/events';
import { GATHERINGS, MISSION } from '../lib/site';

// Carousel = CMS-curated slides + upcoming registrable events from the
// directory app, so both marketing campaigns and real events show up.
const [cmsSlides, events, announcements] = await Promise.all([
  getCarouselSlides(),
  getUpcomingEvents(),
  getAnnouncements(),
]);

// Cap event slides so the carousel stays short even with a full events list.
const eventSlides: CarouselSlide[] = events.slice(0, 4).map((event) => ({
  id: `event-${event.id}`,
  title: event.name,
  subtitle: [formatEventDate(event.date), event.venue].filter(Boolean).join(' · '),
  chip: event.registrationOpen ? 'Registration open' : 'Upcoming event',
  theme: 'dark' as const,
  image: event.bannerUrl,
  href: `/events/${event.slug}`,
}));

const slides = [...cmsSlides, ...eventSlides];
const upcomingEvents = events.slice(0, 3);
const latestNews = announcements.slice(0, 3);

// Text-on-photo mosaic: one tall lead tile, two stacked beside it.
const lifeTiles = [
  {
    title: 'Worship',
    body: 'We gather every week to worship God together, in every location, in every season.',
    src: '/images/site/worship.webp',
    alt: 'Congregation with hands raised during Sunday worship',
  },
  {
    title: 'Community',
    body: 'Life Groups meet during the week. We eat together, pray together, and look after one another.',
    src: '/images/site/community.webp',
    alt: 'Members sharing a meal together after service',
  },
  {
    title: 'Growth',
    body: 'Discipleship classes and Life Groups, from a first visit onward.',
    src: '/images/site/growth.webp',
    alt: 'Small group gathered for teaching at the Quest Laguna hall',
  },
];
const [leadTile, ...sideTiles] = lifeTiles;

function newsDateParts(iso: string) {
  const date = new Date(iso);
  return {
    day: date.toLocaleDateString('en-PH', { day: '2-digit' }),
    month: date.toLocaleDateString('en-PH', { month: 'short' }),
  };
}
---

<Base
  title="Quest Laguna Church | Biñan City, Laguna"
  description="Quest Laguna Church, an independent, evangelical, charismatic church in Biñan City, Laguna, with locations across Laguna, Cavite, and Hungary. Gathering times, locations, and next steps."
>
  <HeroBanner
    variant="photo"
    eyebrow="A church in Laguna, Philippines"
    title="Welcome home."
    body="A church family in Biñan City, with locations across Laguna, Cavite, and beyond."
    image="/images/campaign-banner.jpg"
    imageSrcset="/images/campaign-banner-800.jpg 800w, /images/campaign-banner.jpg 1400w"
    imageAlt="NEXTLEVEL Stronger 2026 campaign"
  >
    <Button href="/visit" variant="on-dark-primary">Plan a visit</Button>
    <Button href="/sermons" variant="on-dark">Watch a service</Button>
  </HeroBanner>

  <section class="px-gutter pt-section-sm pb-4" aria-label="Highlights">
    <EventsCarousel slides={slides} />
  </section>

  <section class="px-gutter py-section" aria-label="About Quest">
    <div class="mx-auto grid max-w-content items-center gap-10 md:grid-cols-[1fr_1.2fr]">
      <img
        src="/images/site/church-family.webp"
        alt="Quest Laguna members gathered together after a Sunday service"
        width={770}
        height={414}
        loading="lazy"
        decoding="async"
        class="h-auto w-full rounded-media shadow-media"
      />
      <div>
        <SectionHeading title="Who we are." />
        <p class="mt-4 text-body text-ink/65">{MISSION.body}</p>
        <p class="mt-3 text-body text-ink/65">
          Quest Laguna began as a church planting mission in Biñan City. Today it is one church
          family in many places across Laguna, Cavite, and beyond.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-5">
          <Button href="/about">About Quest Laguna</Button>
          <a
            href="#gatherings"
            class="inline-flex min-h-11 items-center text-small font-semibold text-maroon underline underline-offset-4"
          >
            Gathering times
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Life at Quest — text on photos, not text beside photos. One tall lead
      tile, two stacked; a different layout family from every card grid
      elsewhere on the page. */}
  <section class="px-gutter pb-section" aria-label="Life at Quest">
    <div class="mx-auto max-w-content">
      <SectionHeading title="Life at Quest." />
      <div class="mt-8 grid gap-4 md:grid-cols-[1.35fr_1fr] md:grid-rows-2">
        <article class="relative overflow-hidden rounded-media shadow-media md:row-span-2">
          <img
            src={leadTile.src}
            alt={leadTile.alt}
            width={900}
            height={718}
            loading="lazy"
            decoding="async"
            class="h-[300px] w-full object-cover md:h-full md:min-h-[420px]"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/25 to-transparent"
            aria-hidden="true"
          >
          </div>
          <div class="absolute inset-x-0 bottom-0 p-6 md:p-8">
            <h3 class="text-title-lg text-white">{leadTile.title}</h3>
            <p class="mt-1.5 max-w-md text-body-sm text-white/85">{leadTile.body}</p>
          </div>
        </article>
        {
          sideTiles.map((tile) => (
            <article class="relative overflow-hidden rounded-media shadow-media">
              <img
                src={tile.src}
                alt={tile.alt}
                width={900}
                height={718}
                loading="lazy"
                decoding="async"
                class="h-[220px] w-full object-cover md:h-full md:min-h-[200px]"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/25 to-transparent"
                aria-hidden="true"
              />
              <div class="absolute inset-x-0 bottom-0 p-6">
                <h3 class="text-title text-white">{tile.title}</h3>
                <p class="mt-1 max-w-md text-body-sm text-white/85">{tile.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="gatherings" class="px-gutter py-section" aria-label="Gathering times">
    <div class="mx-auto max-w-content">
      <img
        src="/images/site/worship-congregation.webp"
        alt="The congregation standing in worship with hands raised, the band on the platform"
        width={1536}
        height={1024}
        loading="lazy"
        decoding="async"
        class="h-auto w-full rounded-media shadow-media"
      />
      <div class="mt-10 grid gap-10 md:grid-cols-[1fr_1.3fr] md:gap-14">
        <div>
          <SectionHeading
            eyebrow="Visit us"
            title="Gathering times."
            body="Family Reunion on Sunday morning is the main gathering. The others run through the week."
          />
          <div class="mt-7">
            <Button href="/visit">Plan a visit</Button>
          </div>
        </div>
        <ul class="divide-y divide-ink/10 border-y border-ink/10">
          {
            GATHERINGS.map((gathering) => (
              <li class="flex flex-col gap-1 py-4 md:flex-row md:items-baseline md:justify-between md:gap-x-6">
                <div>
                  <h3 class="flex flex-wrap items-center gap-2 text-title">
                    {gathering.name}
                    {gathering.online && <Chip variant="tint">Online</Chip>}
                  </h3>
                  <p class="mt-0.5 text-body-sm text-ink/60">{gathering.subtitle}</p>
                </div>
                <p class="text-micro font-bold tracking-[0.12em] whitespace-nowrap text-maroon uppercase">
                  {gathering.schedule}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* The membership pathway, high level. The handbook's internal stage names
      stay in the handbook. */}
  <section id="next-steps" class="bg-cream px-gutter py-section" aria-label="Next steps">
    <div class="mx-auto max-w-narrow">
      <SectionHeading
        eyebrow="From here"
        title="Next steps."
        body="Each step is taken with people who know you. There is no set pace."
        class="mb-8"
      />
      <JourneySteps />
    </div>
  </section>

  {/* Only when something is actually coming up. A heading over an empty grid
      told visitors nothing except that the church had nothing planned. */}
  {
    upcomingEvents.length > 0 && (
      <section class="px-gutter py-section" aria-label="Upcoming events">
        <div class="mx-auto max-w-content">
          <SectionHeading title="Upcoming events.">
            <a
              slot="action"
              href="/events"
              class="inline-flex min-h-11 items-center text-small font-semibold text-maroon underline underline-offset-4"
            >
              All events
            </a>
          </SectionHeading>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {upcomingEvents.map((event) => (
              <EventCard event={event} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-cream px-gutter py-section" aria-label="Latest news">
    <div class="mx-auto max-w-content">
      <SectionHeading title="News and announcements.">
        <a
          slot="action"
          href="/news"
          class="inline-flex min-h-11 items-center text-small font-semibold text-maroon underline underline-offset-4"
        >
          All news
        </a>
      </SectionHeading>
      <div class="mt-6">
        {
          latestNews.map((item) => {
            const { day, month } = newsDateParts(item.date);
            return (
              <article class="flex gap-5 border-b border-ink/10 py-6">
                <div class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-tile bg-white">
                  <span class="display text-display-sm leading-none tabular-nums">{day}</span>
                  <span class="mt-1 text-micro font-bold tracking-widest text-maroon uppercase">
                    {month}
                  </span>
                </div>
                <div>
                  <Chip variant={item.pinned ? 'tint' : 'outline'}>
                    {item.pinned ? 'Pinned' : item.category}
                  </Chip>
                  <h3 class="mt-1.5 text-title">
                    <a
                      href={`/news/${item.slug}`}
                      class="transition-colors duration-200 hover:text-maroon"
                    >
                      {item.title}
                    </a>
                  </h3>
                  <p class="mt-1 text-body-sm text-ink/65">{excerpt(item.body)}</p>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <ClosingBand
    label="You are invited"
    photo={{
      src: '/images/site/praying.webp',
      alt: '',
      width: 900,
      height: 718,
    }}
    title="You are welcome at any gathering."
    body="Family Reunion is every Sunday at 10:00 AM in Biñan City. Questions can be sent through the Connect page first."
    primary={{ href: '/visit', label: 'Plan a visit' }}
    secondary={{ href: '/about', label: 'About Quest Laguna' }}
  />
</Base>
