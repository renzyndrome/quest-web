---
import { FOOTER_LINKS, NAV } from '../lib/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  class="site-header fixed inset-x-0 top-0 z-50 border-b border-ink/10 bg-white/95 backdrop-blur [view-transition-name:site-header]"
>
  <div class="mx-auto flex h-[76px] max-w-[1080px] items-center justify-between px-5 md:px-10">
    <a href="/" class="flex items-center gap-3" aria-label="Quest Laguna — Home">
      <img
        src="/images/logo-mark.png"
        alt=""
        width="40"
        height="40"
        class="rounded-full"
      />
      <span class="font-display text-lg leading-tight font-semibold">
        Quest
        <span class="block font-sans text-[10px] font-bold tracking-[0.3em] text-maroon">
          LAGUNA
        </span>
      </span>
    </a>

    {/* Nine nav items no longer fit beside the wordmark at md, so the full
        nav appears at lg and tablets keep the mobile menu. Even at lg the row
        is tight, hence the narrower gap there and the roomier one from xl up.
        The current page gets a small brand underline instead of a color-only
        cue. */}
    <nav class="hidden items-center gap-4 lg:flex xl:gap-6" aria-label="Main">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={path === item.href ? 'page' : undefined}
            class:list={[
              'relative py-1 text-sm font-semibold transition-colors duration-200',
              'after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:rounded-full after:bg-brand after:opacity-0 after:transition-opacity after:duration-200',
              path === item.href ? 'text-ink after:opacity-100' : 'text-ink/65 hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/visit"
        class="ml-1 inline-flex min-h-10 items-center rounded-full bg-brand px-5 py-2 text-sm font-semibold text-white transition duration-200 ease-swift hover:bg-brand-press active:scale-[0.97]"
      >
        Plan a visit
      </a>
    </nav>

    {/* Mobile: the primary CTA stays visible in the bar, beside the menu
        toggle — most visitors never open the menu. */}
    <div class="flex items-center gap-1.5 lg:hidden">
      <a
        href="/visit"
        class="inline-flex min-h-10 items-center rounded-full bg-brand px-4 py-2 text-sm font-semibold text-white transition duration-200 ease-swift hover:bg-brand-press active:scale-[0.97]"
      >
        Plan a visit
      </a>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-11 w-11 items-center justify-center rounded-full text-ink"
      >
      <span class="sr-only">Toggle menu</span>
      <svg
        data-icon-open
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg
        data-icon-close
        class="hidden"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
      </button>
    </div>
  </div>

  {/* The header is fixed, so anything past the viewport bottom cannot be
      scrolled to with the page — it is simply unreachable. Nine items plus
      the CTA overflow a 560px-tall screen (a 360x640 Android showing its URL
      bar) and landscape phones, which would hide "Plan a visit" entirely.
      Capping the height and scrolling inside the menu is what keeps every
      item reachable. */}
  <nav
    id="mobile-menu"
    hidden
    class="max-h-[calc(100dvh-76px)] overflow-y-auto overscroll-contain border-t border-ink/10 bg-white px-5 pt-2 pb-4 lg:hidden"
    aria-label="Main mobile"
  >
    {/* The drawer carries FOOTER_LINKS, not NAV: it is a scrolling list with
        room to spare, so the pages the desktop row cannot fit (Visit, Pastoral
        services) belong here rather than being mobile-unreachable. */}
    {
      FOOTER_LINKS.map((item) => (
        <a
          href={item.href}
          aria-current={path === item.href ? 'page' : undefined}
          class:list={[
            'block border-b border-ink/5 py-3.5 text-base font-semibold',
            path === item.href ? 'text-brand' : 'text-ink/75',
          ]}
        >
          {item.label}
        </a>
      ))
    }
    <a
      href="/visit"
      class="mt-4 flex min-h-11 w-full items-center justify-center rounded-full bg-brand px-6 py-2.5 text-[15px] font-semibold text-white transition duration-200 ease-swift hover:bg-brand-press active:scale-[0.97]"
    >
      Plan a visit
    </a>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = toggle?.querySelector<SVGElement>('[data-icon-open]');
  const iconClose = toggle?.querySelector<SVGElement>('[data-icon-close]');

  toggle?.addEventListener('click', () => {
    if (!menu || !iconOpen || !iconClose) return;
    // `hidden` is typed boolean | "until-found"; coerce so classList.toggle
    // (which wants a plain boolean) still sees "is currently hidden".
    const opening = Boolean(menu.hidden);
    menu.hidden = !opening;
    iconOpen.classList.toggle('hidden', opening);
    iconClose.classList.toggle('hidden', !opening);
    toggle.setAttribute('aria-expanded', String(opening));
  });
</script>
