---
import Base from '../../layouts/Base.astro';
import HeroBanner from '../../components/HeroBanner.astro';
import EventCard from '../../components/EventCard.astro';
import Button from '../../components/Button.astro';
import { getUpcomingEvents } from '../../lib/events';

const events = await getUpcomingEvents();
---

<Base
  title="Events | Quest Laguna"
  description="Upcoming events at Quest Laguna Church: retreats, classes, baptisms, and gatherings across our locations."
>
  <HeroBanner
    eyebrow="Events"
    title="Events"
    body="Retreats, classes, baptisms, and gatherings across our locations."
  >
    <img
      slot="aside"
      src="/images/site/small-group.webp"
      alt="A discipleship class in small groups at a Quest Laguna hall"
      width={1200}
      height={675}
      class="h-auto w-full rounded-media shadow-media"
    />
  </HeroBanner>

  <section class="px-gutter py-section" aria-label="Upcoming events">
    <div class="mx-auto max-w-content">
      {/* Two columns at most. Events carry a date, a venue and a status, which
          a three-across grid squeezes into unreadable slivers on a phone. */}
      {
        events.length > 0 ? (
          <div class="grid gap-6 md:grid-cols-2">
            {events.map((event) => (
              <EventCard event={event} />
            ))}
          </div>
        ) : (
          <div class="grid items-center gap-8 rounded-card bg-cream px-8 py-10 md:grid-cols-[1fr_1.2fr]">
            <div>
              <h2 class="text-title-lg">No events scheduled at the moment</h2>
              <p class="mt-2 text-body text-ink/65">
                New events are posted here and on our Facebook page. Weekly gatherings need no
                registration.
              </p>
            </div>
            <img
              src="/images/site/small-group.webp"
              alt=""
              width={1200}
              height={675}
              loading="lazy"
              decoding="async"
              class="h-auto w-full rounded-media"
            />
          </div>
        )
      }

      <div class="mt-12 border-t border-ink/10 pt-8">
        <p class="text-body text-ink/65">Events are also posted on our Facebook page.</p>
        <div class="mt-5 flex flex-wrap items-center gap-5">
          <Button href="https://facebook.com/questlaguna" variant="outline">
            Quest Laguna on Facebook
          </Button>
          <a
            href="/news"
            class="inline-flex min-h-11 items-center text-small font-semibold text-maroon underline underline-offset-4"
          >
            News and announcements
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
