---
import Base from '../../layouts/Base.astro';
import PhotoSlot from '../../components/PhotoSlot.astro';
import { getAnnouncements, assetUrl, type Announcement } from '../../lib/directus';

export async function getStaticPaths() {
  const announcements = await getAnnouncements();
  return announcements.map((announcement) => ({
    params: { slug: announcement.slug },
    props: { announcement },
  }));
}

interface Props {
  announcement: Announcement;
}
const { announcement } = Astro.props;
const longDate = new Date(announcement.date).toLocaleDateString('en-PH', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
const bannerSrc = assetUrl(announcement.banner, 'width=1200&format=webp&quality=80');
---

<Base title={`${announcement.title} — Quest Laguna`}>
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-cream to-white" aria-hidden="true">
    </div>
    <div class="mx-auto max-w-[820px] px-5 pt-[120px] pb-10 md:px-10 md:pt-[140px]">
      <a
        href="/news"
        class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-maroon"
      >
        <span aria-hidden="true">‹</span> All news
      </a>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <span class="inline-block rounded-full border border-maroon/40 px-2.5 py-0.5 text-[10px] font-bold tracking-widest text-maroon uppercase">
          {announcement.category}
        </span>
        <span class="text-sm text-ink/55">{longDate}</span>
      </div>
      <h1 class="mt-4 text-3xl leading-[1.15] md:text-5xl">{announcement.title}</h1>
    </div>
  </section>

  <section class="px-5 pb-16 md:px-10 md:pb-24" aria-label="Announcement">
    <div class="mx-auto max-w-[820px]">
      {
        bannerSrc ? (
          <img
            src={bannerSrc}
            alt=""
            width="820"
            height="340"
            class="h-[220px] w-full rounded-media object-cover shadow-media md:h-[340px]"
          />
        ) : (
          <PhotoSlot label="Announcement banner photo" class="h-[200px] w-full md:h-[280px]" />
        )
      }

      {/*
        Trusted content: static build, published-only items from our own
        Directus (limited toolbar, trusted editors, no user-generated
        content). If editor trust ever widens, add a build-time sanitize
        pass in the fetcher — see .claude/rules/content.md.
      */}
      <div class="rich-text mt-8" set:html={announcement.body} />

      <div class="mt-10 border-t border-ink/10 pt-6">
        <a
          href="/news"
          class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-maroon"
        >
          <span aria-hidden="true">‹</span> Back to all news
        </a>
      </div>
    </div>
  </section>
</Base>
