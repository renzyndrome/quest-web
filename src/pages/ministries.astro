---
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import PillButton from '../components/PillButton.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import ScriptureLine from '../components/ScriptureLine.astro';
import { MINISTRY_GROUPS } from '../lib/site';
---

<Base title="Ministries — Quest Laguna">
  <HeroBanner
    eyebrow="Ministries"
    title="Serving at Quest."
    body="Maybe you sing. Maybe you cook, or fix things, or you're good with kids, cameras, or spreadsheets. Every gift has a place here, and serving is how the church keeps going week after week."
    compact
  />

  <section class="px-5 pb-4 md:px-10" aria-label="Scripture">
    <ScriptureLine reference="1 Peter 4:10">
      Each of you should use whatever gift you have received to serve others, as faithful stewards
      of God's grace.
    </ScriptureLine>
  </section>

  {/* Each ministry group card carries its own photo, so there is no separate
      photo strip here — it would repeat the same four images. */}
  <section class="px-5 py-12 md:px-10 md:pb-20" aria-label="Our ministries">
    <div class="reveal mx-auto max-w-[1080px]">
      <h2 class="max-w-2xl text-3xl leading-[1.15] md:text-4xl">
        Every member is a minister.
      </h2>
      <p class="mt-3 max-w-2xl text-[15px] leading-[1.7] text-ink/65">
        Fourteen ministries carry the work of the church. Some are seen on the platform, most are
        not. Every one of them matters.
      </p>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {
          MINISTRY_GROUPS.map((group) => (
            <article class="rounded-card bg-cream px-8 py-9">
              <PhotoSlot
                label={group.photo.label}
                src={group.photo.src}
                alt={group.photo.alt}
                width={group.photo.width}
                height={group.photo.height}
                class="h-auto w-full"
              />
              <div class="mt-6 h-[3px] w-[34px] rounded bg-brand" aria-hidden="true" />
              <h3 class="mt-4 text-xl">{group.title}</h3>
              <p class="mt-2.5 text-sm leading-[1.7] text-ink/65">{group.body}</p>
              <ul class="mt-5 space-y-3.5">
                {group.ministries.map((ministry) => (
                  <li>
                    <span class="block text-[15px] font-semibold text-ink">{ministry.name}</span>
                    <span class="block text-sm leading-[1.6] text-ink/60">{ministry.blurb}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-cream px-5 py-16 md:px-10 md:py-20" aria-label="Get in touch">
    <div class="mx-auto max-w-[640px] text-center">
      <h2 class="text-2xl md:text-3xl">Not sure where you fit?</h2>
      <p class="mt-3 text-[15px] leading-[1.7] text-ink/65">
        That's okay. Talk to the pastor at your location, or send us a message and we'll help you
        find a team to try. You can always switch later.
      </p>
      <div class="mt-7 flex justify-center">
        <PillButton href="/connect">Get in touch</PillButton>
      </div>
    </div>
  </section>
</Base>
