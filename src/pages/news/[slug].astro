---
import Base from '../../layouts/Base.astro';
import ArticleDetail from '../../components/ArticleDetail.astro';
import { getAnnouncements, excerpt, type Announcement } from '../../lib/directus';

export async function getStaticPaths() {
  const announcements = await getAnnouncements();
  return announcements.map((announcement) => ({
    params: { slug: announcement.slug },
    props: { announcement },
  }));
}

interface Props {
  announcement: Announcement;
}
const { announcement } = Astro.props;
---

<Base
  title={`${announcement.title} — Quest Laguna`}
  description={excerpt(announcement.body, 160)}
>
  <ArticleDetail announcement={announcement} />
</Base>
