---
interface Props {
  onDark?: boolean;
}
const { onDark = false } = Astro.props;
---

<p
  class:list={[
    'flex items-center gap-2.5 text-xs font-bold tracking-[0.2em] uppercase',
    onDark ? 'text-white/85' : 'text-maroon',
  ]}
>
  <span aria-hidden="true" class="h-px w-6 bg-current opacity-70"></span>
  <slot />
</p>
