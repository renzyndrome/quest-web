---
/*
  Shared event detail body. Rendered by both the static detail page
  (src/pages/events/[slug].astro) and the on-demand draft preview route
  (src/pages/events/preview/[slug].astro) so published and preview views stay
  identical — the same arrangement ArticleDetail uses for news.
*/
import DetailHeader from './DetailHeader.astro';
import Chip from './Chip.astro';
import Button from './Button.astro';
import { formatEventDate, formatEventTime, type ChurchEvent } from '../lib/events';

interface Props {
  event: ChurchEvent;
}
const { event } = Astro.props;
const time = formatEventTime(event.time);

const meta = [
  formatEventDate(event.date) + (time ? ` · ${time}` : ''),
  ...(event.venue ? [event.venue] : []),
];
---

<DetailHeader backHref="/events" backLabel="All events" title={event.name}>
  <Fragment slot="chips">
    <Chip variant={event.registrationOpen ? 'tint' : 'outline'}>
      {event.registrationOpen ? 'Registration open' : 'Upcoming event'}
    </Chip>
  </Fragment>
  <div class="mt-4 space-y-1" slot="meta">
    {
      meta.map((row) => (
        <p class="text-small font-semibold tracking-[0.08em] text-maroon uppercase">{row}</p>
      ))
    }
  </div>
</DetailHeader>

<section class="px-gutter py-section" aria-label="Event details">
  <div class="mx-auto max-w-narrow">
    {
      event.bannerUrl && (
        <img
          src={event.bannerUrl}
          alt={event.bannerAlt ?? ''}
          width="820"
          height="340"
          class="h-auto w-full rounded-media shadow-media"
        />
      )
    }

    {/* Trusted content — same assumption as news/[slug]; see .claude/rules/content.md */}
    {
      event.description && (
        <div class:list={['rich-text', event.bannerUrl ? 'mt-8' : '']} set:html={event.description} />
      )
    }

    <div class="mt-9 flex flex-wrap items-center gap-4">
      {
        event.registrationUrl ? (
          <Button href={event.registrationUrl}>Register</Button>
        ) : (
          <p class="text-body-sm text-ink/60">
            Registration details will be posted here and on our{' '}
            <a
              href="https://facebook.com/questlaguna"
              rel="noopener"
              class="font-semibold text-maroon underline underline-offset-4"
            >
              Facebook page
            </a>
            .
          </p>
        )
      }
    </div>
  </div>
</section>
