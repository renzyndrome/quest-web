---
/*
  The header every detail page shares: back link, chip row, title, meta. The
  three detail bodies previously carried three byte-identical copies of this
  markup, which is how they stayed identical only by luck.
*/
interface Props {
  backHref: string;
  backLabel: string;
  title: string;
}
const { backHref, backLabel, title } = Astro.props;
---

<section class="border-b border-cream-200 bg-cream">
  <div class="mx-auto max-w-narrow px-gutter pt-[116px] pb-10 md:pt-[140px]">
    <a
      href={backHref}
      class="inline-flex min-h-11 items-center gap-1.5 text-small font-semibold text-maroon"
    >
      <span aria-hidden="true">&lsaquo;</span>
      {backLabel}
    </a>
    {
      Astro.slots.has('chips') && (
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <slot name="chips" />
        </div>
      )
    }
    <h1 class="display mt-4 text-display-lg">{title}</h1>
    <slot name="meta" />
  </div>
</section>
