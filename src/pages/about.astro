---
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import ScriptureLine from '../components/ScriptureLine.astro';
import {
  BELIEFS,
  DISTINCTIVE,
  CORE_VALUES,
  CULTURE,
  IDENTITY,
  IDENTITY_MARKS,
  MISSION,
  PASSION,
  SCRIPTURES,
  VISION,
} from '../lib/site';

// Every fact on this page comes from the official church handbook, by way of
// src/lib/site.ts. Never restate a date, a name, or a belief from memory.
const pillars = [
  { eyebrow: 'Our vision', ...VISION },
  { eyebrow: 'Our mission', ...MISSION },
  { eyebrow: 'Our passion', ...PASSION },
];
---

<Base
  title="About | Quest Laguna"
  description="Quest Laguna Church is an independent, evangelical, charismatic church in Biñan City, Laguna. Our story, what we believe, and where we are going."
>
  <HeroBanner
    eyebrow="About Quest"
    title="Who we are and what we believe."
    body="Quest Laguna Church exists to help people know Christ and grow in Him. From there, we raise disciple makers for their families, communities, workplaces, campuses, and the nations."
  >
    <Button href="/visit">Plan a visit</Button>
    <Button href="#beliefs" variant="outline">What we believe</Button>
    <img
      slot="aside"
      src="/images/site/church-family.webp"
      alt="Quest Laguna members gathered together after a Sunday service"
      width={770}
      height={414}
      class="h-auto w-full rounded-media shadow-media"
    />
  </HeroBanner>

  <section class="px-gutter py-section" aria-label="Our story">
    <div class="mx-auto grid max-w-content items-center gap-10 md:grid-cols-[1fr_1.2fr]">
      {/* The early days, from the church's own archive: the Red Tag event at
          Quest Molino, the rented bodega the church first met in, and an
          early prayer circle. Low-resolution originals, shown small on
          purpose. */}
      <div class="grid gap-4">
        <img
          src="/images/site/began-red-tag.webp"
          alt="The Red Tag event at Quest Molino, a worship team on a small stage in front of a seated crowd"
          width={960}
          height={720}
          loading="lazy"
          decoding="async"
          class="h-auto w-full rounded-media shadow-media"
        />
        <div class="grid grid-cols-2 gap-4">
          <img
            src="/images/site/began-bodega.webp"
            alt="The rented bodega where Quest Laguna first gathered"
            width={960}
            height={960}
            loading="lazy"
            decoding="async"
            class="aspect-square h-auto w-full rounded-media object-cover shadow-media"
          />
          <img
            src="/images/site/began-prayer.webp"
            alt="An early prayer circle of young people in the first meeting hall"
            width={960}
            height={720}
            loading="lazy"
            decoding="async"
            class="aspect-square h-auto w-full rounded-media object-cover shadow-media"
          />
        </div>
      </div>
      <div>
        <SectionHeading eyebrow="Our story" title="How Quest Laguna began." />
        <p class="mt-5 text-body text-ink/65">
          Quest Laguna Church began with one burden: to lead people into a real relationship with
          Jesus Christ, and to raise disciples who would change their families, communities,
          workplaces, and campuses.
        </p>
        <p class="mt-3 text-body text-ink/65">
          What began as a church planting mission in Biñan City, Laguna was officially established
          in {IDENTITY.established} under the leadership of {IDENTITY.leader}. {IDENTITY.legalName} is
          registered with the Securities and Exchange Commission of the Philippines.
        </p>
        <p class="mt-3 text-body text-ink/65">
          Since then, Life Groups have been formed, leaders have been raised, and new mission points
          and satellite churches have opened in other communities. Our desire has never been simply
          a larger crowd. It has always been faithful disciples.
        </p>
      </div>
    </div>
  </section>

  {/* "Isang Dekada" is the campaign's own name (editorial material from
      marketing) — the graphics carry the season-by-season story themselves. */}
  <section class="bg-cream px-gutter py-section" aria-label="Isang Dekada">
    <div class="mx-auto max-w-content">
      <SectionHeading
        title="Isang Dekada."
        body="The seasons God has carried us through, from Breakthrough in 2017 to Revival in 2025."
      />
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <img
          src="/images/site/isang-dekada-1.webp"
          alt="Isang Dekada timeline, 2017 to 2021: Breakthrough, All-Out, Sisid, Laban, and Unshakable"
          width={900}
          height={1125}
          loading="lazy"
          decoding="async"
          class="h-auto w-full rounded-media shadow-media"
        />
        <img
          src="/images/site/isang-dekada-2.webp"
          alt="Isang Dekada timeline, 2022 to 2025: Overflow, Unstoppable, Empowered, Stronger, and Revival"
          width={900}
          height={1125}
          loading="lazy"
          decoding="async"
          class="h-auto w-full rounded-media shadow-media"
        />
      </div>
      <div class="mt-12">
        <ScriptureLine reference={SCRIPTURES.glory.reference} text={SCRIPTURES.glory.text} />
      </div>
    </div>
  </section>

  <section class="px-gutter py-section" aria-label="Who we are">
    <div class="mx-auto max-w-content">
      <SectionHeading title="Three words that describe us." />
      <div class="mt-10 grid gap-8 md:grid-cols-3 md:gap-10">
        {
          IDENTITY_MARKS.map((mark) => (
            <article class="border-t-2 border-brand pt-5">
              <h3 class="text-title-lg">{mark.title}</h3>
              <p class="mt-2.5 text-body text-ink/65">{mark.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/*
    The church's own identity statement, reproduced verbatim from
    src/lib/site.ts. Pastor Apple asked for it as she wrote it, so nothing here
    is folded away behind a click.
  */}
  <section id="distinctive" class="bg-cream px-gutter py-section" aria-label="Our distinctive">
    {/* Text first, photo second — the mirror of "Our culture" two sections
        below, which is otherwise the same two-column shape on the same page. */}
    <div class="mx-auto grid max-w-content gap-10 md:grid-cols-[1.3fr_1fr] md:items-start">
      <div class="md:order-2">
        <SectionHeading eyebrow="Our distinctive" title={DISTINCTIVE.title} />
        <img
          src="/images/site/growth.webp"
          alt="A Quest Laguna leader teaching a seated group"
          width={900}
          height={718}
          loading="lazy"
          decoding="async"
          class="mt-8 h-auto w-full rounded-media shadow-media"
        />
      </div>

      <div class="md:order-1">
        <div class="space-y-4">
          {
            DISTINCTIVE.blocks.map((block) =>
              block.kind === 'scripture' ? (
                <div class="py-4">
                  <ScriptureLine reference={block.reference}>{block.text}</ScriptureLine>
                </div>
              ) : (
                <p class="text-body text-ink/65">
                  {block.text}
                  {block.quote && <span lang={block.quote.lang}>{block.quote.text}</span>}
                </p>
              ),
            )
          }
        </div>
      </div>
    </div>
  </section>

  {/* The one dark band on the page — vision, mission, passion carry the
      weight without cards or a photo. */}
  <section
    class="bg-maroon-deep px-gutter py-section text-white"
    aria-label="Vision, mission and passion"
  >
    <div class="mx-auto max-w-content">
      <SectionHeading title="Vision, mission, passion." onDark />
      <div class="mt-10 grid gap-8 md:grid-cols-3 md:gap-10">
        {
          pillars.map((pillar) => (
            <article class="border-t border-white/25 pt-5">
              <p class="text-micro font-bold tracking-[0.2em] text-red-soft uppercase">
                {pillar.eyebrow}
              </p>
              <h3 class="mt-2 text-title-lg leading-snug text-white">{pillar.name}</h3>
              <p class="mt-2.5 text-body text-white/70">{pillar.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-cream px-gutter py-section" aria-label="Our culture">
    <div class="mx-auto grid max-w-content gap-10 md:grid-cols-[1fr_1.3fr] md:items-start">
      <div>
        <SectionHeading
          title="How we live and serve together."
          body="Seven commitments we ask of everyone who calls Quest home."
        />
        <img
          src="/images/site/ministry-serving.webp"
          alt="Volunteers serving together before a Sunday service"
          width={900}
          height={413}
          loading="lazy"
          decoding="async"
          class="mt-8 h-auto w-full rounded-media shadow-media"
        />
      </div>
      <ul class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
        {
          CULTURE.map((value) => (
            <li>
              <div class="h-[3px] w-[18px] rounded bg-brand" aria-hidden="true" />
              <h3 class="mt-2.5 text-title">{value.name}</h3>
              <p class="mt-1 text-body-sm text-ink/60">{value.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="px-gutter py-section" aria-label="Our core values">
    <div class="mx-auto grid max-w-content items-center gap-10 md:grid-cols-[1.1fr_1fr]">
      <div>
        <SectionHeading
          title="Character before achievement."
          body="Above every ministry and every milestone, we pursue Christlike character. Our greatest success is not attendance. It is transformed lives that look more and more like Jesus."
        />
        <ul class="mt-7 grid gap-x-6 gap-y-3 sm:grid-cols-2">
          {
            CORE_VALUES.map((value) => (
              <li class="flex items-start gap-2.5 text-body-sm text-ink/75">
                <span aria-hidden="true" class="mt-2 h-[3px] w-[18px] shrink-0 rounded bg-brand" />
                {value}
              </li>
            ))
          }
        </ul>
      </div>
      <img
        src="/images/site/praying.webp"
        alt="Members gathered around one another in prayer"
        width={900}
        height={718}
        loading="lazy"
        decoding="async"
        class="h-auto w-full rounded-media shadow-media"
      />
    </div>
  </section>

  <section id="beliefs" class="bg-cream px-gutter py-section" aria-label="What we believe">
    <div class="mx-auto max-w-narrow">
      <SectionHeading
        eyebrow="What we believe"
        title="The Seven Quest Beliefs"
        body="These convictions shape our worship, preaching, discipleship, and daily life together. Open any belief to read it in full."
      />

      {/* Wide shot at natural aspect — the previous tall group photo lost
          everyone's faces when squeezed into a wide strip. */}
      <img
        src="/images/site/worship-hands.webp"
        alt="Hands raised in worship during a Sunday service"
        width={1600}
        height={742}
        loading="lazy"
        decoding="async"
        class="mt-8 h-auto w-full rounded-media shadow-media"
      />

      <div class="mt-9 divide-y divide-ink/10 border-y border-ink/10">
        {
          BELIEFS.map((belief) => (
            <details class="group">
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-5 text-left text-title font-semibold text-ink [&::-webkit-details-marker]:hidden">
                {belief.title}
                <span
                  aria-hidden="true"
                  class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-ink/15 text-maroon transition-transform duration-200 group-open:rotate-45"
                >
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                </span>
              </summary>
              <div class="pb-6">
                <p class="text-body text-ink/65">{belief.body}</p>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {belief.refs.map((ref) => (
                    <li class="rounded-full border border-gold/45 bg-white px-3.5 py-2 text-micro font-semibold text-gold-deep">
                      {ref}
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ))
        }
      </div>

      <p class="mt-8 text-body-sm text-ink/60">
        We joyfully submit to the authority of God's Word, depend on the power of the Holy Spirit,
        and stay steadfast in making Christlike disciples for the glory of God.
      </p>

      {/* Two links rather than a band. The footer's scripture closes the page. */}
      <div class="mt-10 flex flex-wrap items-center gap-5 border-t border-ink/10 pt-6">
        <Button href="/visit">Plan a visit</Button>
        <a
          href="/testimonies"
          class="inline-flex min-h-11 items-center text-small font-semibold text-maroon underline underline-offset-4"
        >
          Life testimonies
        </a>
      </div>
    </div>
  </section>
</Base>
