# Postgres password for the genzeal database. Generate with: openssl rand -hex 32
DB_PASSWORD=
# Postgres user (default: genzeal)
DB_USER=genzeal
# Postgres database name (default: genzeal)
DB_DATABASE=genzeal
# Password for the page editor (/edit). Generate with: openssl rand -hex 32
EDITOR_PASSWORD=

# Photo storage on Cloudflare R2. Leave all unset to keep photos on the uploads volume.
# SAME bucket and credentials as the CMS (cms/.env.example); objects land under genzeal/.
# Bucket name. Setting it switches uploads to R2.
R2_BUCKET=
# Cloudflare account id (forms the R2 endpoint).
R2_ACCOUNT_ID=
# R2 API token access key id.
R2_ACCESS_KEY_ID=
# R2 API token secret.
R2_SECRET_ACCESS_KEY=
# Public base URL of the bucket, e.g. https://media.questlaguna.org. No trailing slash.
R2_PUBLIC_URL=
