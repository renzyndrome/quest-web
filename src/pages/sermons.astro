---
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import PillButton from '../components/PillButton.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Chip from '../components/Chip.astro';
import { GATHERINGS, SERMON_SERVICES } from '../lib/site';
import { YT_UPLOADS_PLAYLIST, YT_CHANNEL_URL, YT_LIVE_URL, getSermons } from '../lib/youtube';

// Per-service playlists (categorized), else the keyless channel feed, else samples.
const { entries: sermons, categorized } = await getSermons();
const serviceName = (slug: string) =>
  SERMON_SERVICES.find((service) => service.sermonSlug === slug)?.name ?? slug;

// Only gatherings that actually stream on the channel get a "we're live"
// banner — a wrong link is worse than no banner.
const liveWindows = GATHERINGS.filter((gathering) => gathering.liveOnYouTube).map((gathering) => ({
  day: gathering.day,
  start: gathering.startMin,
  end: gathering.startMin + gathering.durationMin,
}));
const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' });
---

<Base title="Sermons & services — Quest Laguna">
  <HeroBanner
    eyebrow="Watch again"
    title="Sermons & services"
    body="Missed a service? Everything is recorded. Watch the latest one below, or browse the archive by service."
    compact
  />

  {/* Live banner — revealed before paint by the is:inline script below only
      during a service window (Asia/Manila), so no layout shift on the video. */}
  <div data-live-banner hidden class="px-5 md:px-10">
    <a
      href={YT_LIVE_URL}
      rel="noopener"
      class="mx-auto flex max-w-[1080px] items-center justify-center gap-3 rounded-card bg-brand px-6 py-4 text-center text-[15px] font-semibold text-white transition-colors duration-200 hover:bg-brand-press"
    >
      <span class="relative flex h-2.5 w-2.5">
        <span
          class="absolute inline-flex h-full w-full rounded-full bg-white/70 motion-safe:animate-ping"
        ></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-white"></span>
      </span>
      We're live right now. Watch the service.
    </a>
  </div>

  {/* Runs synchronously during parse (before the video below), so revealing
      the banner during a service window causes no layout shift. Windows come
      from GATHERINGS in src/lib/site.ts — minutes past midnight, Asia/Manila. */}
  <script is:inline define:vars={{ WINDOWS: liveWindows }}>
    (function () {
      try {
        var parts = new Intl.DateTimeFormat('en-US', {
          timeZone: 'Asia/Manila',
          weekday: 'short',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
        }).formatToParts(new Date());
        var get = function (type) {
          for (var i = 0; i < parts.length; i++) if (parts[i].type === type) return parts[i].value;
          return '';
        };
        var days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
        var day = days.indexOf(get('weekday'));
        var minutes = (parseInt(get('hour'), 10) % 24) * 60 + parseInt(get('minute'), 10);
        var live = WINDOWS.some(function (w) {
          return w.day === day && minutes >= w.start && minutes < w.end;
        });
        if (live) {
          var banner = document.querySelector('[data-live-banner]');
          if (banner) banner.hidden = false;
        }
      } catch (e) {
        /* Intl unavailable — leave the banner hidden */
      }
    })();
  </script>

  <section class="px-5 pt-8 pb-16 md:px-10" aria-label="Latest service">
    <div class="mx-auto max-w-[1080px]">
      <YouTubeEmbed
        playlistId={YT_UPLOADS_PLAYLIST}
        title="Latest Quest Laguna service"
        class="rounded-card shadow-media"
      />
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-ink/60">
          From our YouTube channel. This updates automatically every week.
        </p>
        <PillButton href={YT_CHANNEL_URL} variant="outline">View channel</PillButton>
      </div>
    </div>
  </section>

  <section class="bg-cream px-5 py-16 md:px-10 md:py-20" aria-label="Our gatherings">
    <div class="mx-auto max-w-[1080px]">
      <Eyebrow>Our gatherings</Eyebrow>
      <h2 class="mt-3 text-3xl md:text-4xl">We gather all week long.</h2>
      <p class="mt-3 max-w-2xl text-[15px] leading-[1.7] text-ink/65">
        Every gathering has its own place in the week. The ones we record have their own recordings
        in the archive below.
      </p>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          GATHERINGS.map((gathering) =>
            gathering.sermonSlug ? (
              <button
                type="button"
                data-service-link={gathering.sermonSlug}
                class="rounded-card border border-ink/5 bg-white px-6 py-7 text-left transition-shadow duration-200 hover:shadow-card"
              >
                <p class="text-xs font-bold tracking-[0.12em] text-maroon uppercase">
                  {gathering.schedule}
                </p>
                <h3 class="mt-2 text-lg">{gathering.name}</h3>
                <p class="mt-1.5 text-sm text-ink/60">{gathering.subtitle}</p>
              </button>
            ) : (
              <article class="rounded-card border border-ink/5 bg-white px-6 py-7">
                <p class="text-xs font-bold tracking-[0.12em] text-maroon uppercase">
                  {gathering.schedule}
                </p>
                <h3 class="mt-2 flex flex-wrap items-center gap-2 text-lg">
                  {gathering.name}
                  {gathering.online && <Chip variant="tint">Online</Chip>}
                </h3>
                <p class="mt-1.5 text-sm text-ink/60">{gathering.subtitle}</p>
              </article>
            ),
          )
        }
      </div>
    </div>
  </section>

  <section id="archive" class="px-5 py-16 md:px-10 md:py-24" aria-label="Service archive">
    <div class="mx-auto max-w-[1080px]">
      <Eyebrow>Archive</Eyebrow>
      <h2 class="mt-3 text-3xl md:text-4xl">Watch a past service.</h2>

      {
        categorized && (
          <div class="mt-8 flex flex-wrap gap-2.5" aria-label="Filter by service">
            {[
              { slug: 'all', name: 'All' },
              ...SERMON_SERVICES.map((service) => ({ slug: service.sermonSlug, name: service.name })),
            ].map((tab, i) => (
              <button
                type="button"
                data-tab={tab.slug}
                aria-pressed={i === 0 ? 'true' : 'false'}
                class="min-h-11 rounded-full border border-ink/10 bg-white px-5 py-2.5 text-sm font-semibold text-ink/70 transition-colors duration-200 hover:border-brand/50 aria-pressed:border-transparent aria-pressed:bg-brand aria-pressed:text-white"
              >
                {tab.name}
              </button>
            ))}
          </div>
        )
      }

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          sermons.map((sermon) => (
            <article
              data-sermon
              data-service={sermon.service ?? ''}
              class="overflow-hidden rounded-card border border-ink/5 bg-white shadow-card"
            >
              <YouTubeEmbed
                videoId={sermon.videoId}
                playlistId={YT_UPLOADS_PLAYLIST}
                title={sermon.title}
              />
              <div class="p-5">
                {sermon.service && (
                  <span class="rounded-full bg-red-tint px-3 py-1 text-[10px] font-bold tracking-widest text-maroon uppercase">
                    {serviceName(sermon.service)}
                  </span>
                )}
                <h3 class:list={['text-base', sermon.service && 'mt-2.5']}>{sermon.title}</h3>
                <p class="mt-1 text-[13px] text-ink/55">{formatDate(sermon.date)}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-14 flex flex-col items-center gap-4 text-center">
        <h3 class="text-xl">Looking for an older recording?</h3>
        <PillButton href={YT_CHANNEL_URL}>Browse the full archive on YouTube</PillButton>
        <p class="text-sm text-ink/55">
          Services also stream live on our
          <a
            href="https://facebook.com/questlaguna"
            rel="noopener"
            class="font-semibold text-maroon underline underline-offset-4">Facebook page</a
          >.
        </p>
      </div>
    </div>
  </section>

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-sermon]'));

    function setFilter(value: string) {
      // No tabs rendered (uncategorized feed) → don't filter; keep all visible.
      if (tabs.length === 0) return;
      tabs.forEach((tab) => tab.setAttribute('aria-pressed', String(tab.dataset.tab === value)));
      cards.forEach((card) => {
        card.hidden = value !== 'all' && card.dataset.service !== value;
      });
    }

    tabs.forEach((tab) => tab.addEventListener('click', () => setFilter(tab.dataset.tab ?? 'all')));

    const smooth = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ? 'auto'
      : 'smooth';
    document.querySelectorAll<HTMLButtonElement>('[data-service-link]').forEach((button) =>
      button.addEventListener('click', () => {
        setFilter(button.dataset.serviceLink ?? 'all');
        document.getElementById('archive')?.scrollIntoView({ behavior: smooth as ScrollBehavior });
      }),
    );
    // The live banner is revealed by the is:inline script near the top of the
    // page (before paint) to avoid layout shift.
  </script>
</Base>
