---
import { LOCATIONS, MISSION, SCRIPTURE_FOOTER } from '../lib/sample-content';

const explore = [
  { label: 'Home', href: '/' },
  { label: 'Sermons', href: '/sermons' },
  { label: 'Ministries', href: '/ministries' },
  { label: 'News', href: '/news' },
  { label: 'Give', href: '/give' },
  { label: 'Connect', href: '/connect' },
];

const half = Math.ceil(LOCATIONS.length / 2);
const locationCols = [LOCATIONS.slice(0, half), LOCATIONS.slice(half)];
const year = new Date().getFullYear();
---

<footer class="bg-ink text-white">
  <div
    class="mx-auto grid max-w-[1080px] gap-10 px-5 py-14 md:grid-cols-[1.4fr_1fr_1fr_1fr] md:px-10 md:py-16"
  >
    <div>
      <a href="/" class="flex items-center gap-3" aria-label="Quest Laguna — Home">
        <img src="/images/logo-mark.png" alt="" width="44" height="44" class="rounded-full" />
        <span class="font-display text-lg leading-tight font-semibold">
          Quest
          <span class="block font-sans text-[10px] font-bold tracking-[0.3em] text-red-soft">
            LAGUNA
          </span>
        </span>
      </a>
      <p class="mt-5 max-w-xs text-sm leading-relaxed text-white/60">{MISSION}</p>
      <a
        href="https://facebook.com/questlaguna"
        rel="noopener"
        class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-white/80 transition-colors duration-200 hover:text-white"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.2-1.5 1.5-1.5h1.4V4.9c-.3 0-1.1-.1-2.1-.1-2.1 0-3.6 1.3-3.6 3.7V11H8.3v3h2.4v7h2.8z"
          ></path>
        </svg>
        facebook.com/questlaguna
      </a>
    </div>

    {
      locationCols.map((col, i) => (
        <div>
          <h4 class="text-xs font-bold tracking-[0.2em] text-white/45 uppercase">
            {i === 0 ? 'Locations' : ' '}
          </h4>
          <ul class="mt-4 space-y-2.5">
            {col.map((location) => (
              <li class="text-sm text-white/70">{location}</li>
            ))}
          </ul>
        </div>
      ))
    }

    <div>
      <h4 class="text-xs font-bold tracking-[0.2em] text-white/45 uppercase">Explore</h4>
      <ul class="mt-4 space-y-2.5">
        {
          explore.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-white/70 transition-colors duration-200 hover:text-white"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div
      class="mx-auto flex max-w-[1080px] flex-col gap-2 px-5 py-6 text-xs text-white/45 md:flex-row md:items-center md:justify-between md:px-10"
    >
      <p>© {year} Quest Laguna. All rights reserved.</p>
      <p>{SCRIPTURE_FOOTER}</p>
    </div>
  </div>
</footer>
