---
/*
  Category / status pill used on news rows, detail headers, and cards.
  Two looks: outlined maroon (default, for categories) and soft red tint
  (filled, for statuses like "Pinned"/"Registration open").
*/
interface Props {
  variant?: 'outline' | 'tint';
  class?: string;
}
const { variant = 'outline', class: className = '' } = Astro.props;

const variants = {
  outline: 'border border-maroon/40 text-maroon',
  tint: 'bg-red-tint text-maroon',
};
---

<span
  class:list={[
    'inline-block rounded-full px-2.5 py-0.5 text-[10px] font-bold tracking-widest uppercase',
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
