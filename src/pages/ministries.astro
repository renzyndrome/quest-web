---
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import ScriptureLine from '../components/ScriptureLine.astro';
import { MINISTRY_GROUPS, SCRIPTURES } from '../lib/site';
---

<Base
  title="Ministries | Quest Laguna"
  description="The fourteen ministries of Quest Laguna Church: worship and creative, care and welcome, next generation and family, operations and missions."
>
  <HeroBanner
    eyebrow="Ministries"
    title="Serving at Quest."
    body="Some serve by singing or playing. Others cook, fix things, or work with children, cameras, or spreadsheets. Every gift has a place, and serving is how the church keeps going week after week."
  />

  <section class="px-gutter pt-10 pb-4" aria-label="Scripture">
    <ScriptureLine reference={SCRIPTURES.serving.reference} text={SCRIPTURES.serving.text} />
  </section>

  {/* Each ministry group card carries its own photo, so there is no separate
      photo strip here — it would repeat the same four images. */}
  <section class="px-gutter py-section" aria-label="Our ministries">
    <div class="mx-auto max-w-content">
      <SectionHeading
        title="Every member is a minister."
        body="Fourteen ministries carry the work of the church. Some are seen on the platform, most are not. Every one of them matters."
      />

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {
          MINISTRY_GROUPS.map((group) => (
            <article class="rounded-card bg-cream px-8 py-9">
              <img
                src={group.photo.src}
                alt={group.photo.alt}
                width={group.photo.width}
                height={group.photo.height}
                loading="lazy"
                decoding="async"
                class="h-auto w-full rounded-media"
              />
              <div class="mt-6 h-[3px] w-[34px] rounded bg-brand" aria-hidden="true" />
              <h3 class="mt-4 text-title-lg">{group.title}</h3>
              <p class="mt-2.5 text-body-sm text-ink/65">{group.body}</p>
              <ul class="mt-5 space-y-3.5">
                {group.ministries.map((ministry) => (
                  <li>
                    <span class="block text-body-sm font-semibold text-ink">{ministry.name}</span>
                    <span class="block text-body-sm text-ink/60">{ministry.blurb}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-cream px-gutter py-section-sm" aria-label="Get in touch">
    <div class="mx-auto max-w-copy text-center">
      <h2 class="text-display-sm">Not sure where you fit?</h2>
      <p class="mt-3 text-body text-ink/65">
        The pastor at your location can suggest a team to try. A message through the Connect page
        reaches the same people, and switching teams later is always possible.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-4">
        <Button href="/connect">Get in touch</Button>
        <Button href="/services" variant="outline">Pastoral services</Button>
      </div>
    </div>
  </section>
</Base>
