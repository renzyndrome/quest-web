---
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import Chip from '../components/Chip.astro';
import { getAnnouncements, excerpt } from '../lib/cms';

const announcements = await getAnnouncements();
const pinned = announcements.find((item) => item.pinned);
const rest = announcements.filter((item) => item !== pinned);

function dateParts(iso: string) {
  const date = new Date(iso);
  return {
    day: date.toLocaleDateString('en-PH', { day: '2-digit' }),
    month: date.toLocaleDateString('en-PH', { month: 'short' }),
  };
}
const longDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' });
---

<Base title="News & announcements — Quest Laguna">
  <HeroBanner eyebrow="What's happening" title="News & announcements" compact />

  <section class="px-5 pb-16 md:px-10 md:pb-24" aria-label="Announcements">
    <div class="mx-auto max-w-[820px]">
      {
        pinned && (
          <article class="mb-10 rounded-card border border-maroon/15 bg-cream p-7 md:p-9">
            <div class="flex flex-wrap items-center gap-3">
              <span class="rounded-full bg-brand px-3.5 py-1.5 text-[10px] font-bold tracking-widest text-white uppercase">
                Pinned
              </span>
              <span class="text-sm text-ink/55">
                {longDate(pinned.date)} · {pinned.category}
              </span>
            </div>
            {pinned.banner ? (
              <img
                src={pinned.banner ?? ''}
                alt={pinned.bannerAlt ?? ''}
                loading="lazy"
                width="1200"
                height="220"
                class="mt-5 h-[220px] w-full rounded-media object-cover"
              />
            ) : (
              <PhotoSlot label="Announcement banner photo" class="mt-5 h-[180px] w-full md:h-[220px]" />
            )}
            <h2 class="mt-5 text-2xl">
              <a
                href={`/news/${pinned.slug}`}
                class="transition-colors duration-200 hover:text-maroon"
              >
                {pinned.title}
              </a>
            </h2>
            <p class="mt-2.5 text-[15px] leading-[1.7] text-ink/65">{excerpt(pinned.body, 220)}</p>
            <a
              href={`/news/${pinned.slug}`}
              class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-maroon underline underline-offset-4"
            >
              Read more
            </a>
          </article>
        )
      }

      {
        rest.map((item) => {
          const { day, month } = dateParts(item.date);
          return (
            <article class="flex gap-5 border-b border-ink/10 py-7">
              <div class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-xl bg-cream">
                <span class="font-display text-[22px] leading-none font-semibold">{day}</span>
                <span class="mt-0.5 text-[11px] font-bold tracking-widest text-maroon uppercase">
                  {month}
                </span>
              </div>
              <div>
                <Chip>{item.category}</Chip>
                <h2 class="mt-2 text-xl">
                  <a
                    href={`/news/${item.slug}`}
                    class="transition-colors duration-200 hover:text-maroon"
                  >
                    {item.title}
                  </a>
                </h2>
                <p class="mt-1.5 text-[15px] leading-[1.65] text-ink/65">{excerpt(item.body)}</p>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>
</Base>
