---
/*
  Full-bleed, image-first hero, composed editorially: content sits bottom-left
  over a bottom-weighted scrim, never centered. With an image: photo background,
  white text, tall stage. Without: warm cream gradient, ink text, left-aligned.
  pt clears the fixed 76px header.
*/
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow: string;
  title: string;
  body?: string;
  image?: string | null;
  imageSrcset?: string;
  imageAlt?: string;
  compact?: boolean;
}
const {
  eyebrow,
  title,
  body,
  image = null,
  imageSrcset,
  imageAlt = '',
  compact = false,
} = Astro.props;
const onDark = Boolean(image);
---

<section class="relative isolate overflow-hidden">
  {
    image ? (
      <>
        <img
          src={image}
          srcset={imageSrcset}
          sizes={imageSrcset ? '100vw' : undefined}
          alt={imageAlt}
          class="absolute inset-0 -z-20 h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
        {/* Bottom-weighted scrim: the photo stays visible up top, the copy
            sits on the darkest band. The campaign banner has its own baked-in
            typography, so the bottom must go properly dark. */}
        <div
          class="absolute inset-0 -z-10 bg-gradient-to-b from-ink/45 via-maroon-deep/50 to-ink/95"
          aria-hidden="true"
        />
        {/* Second, horizontal scrim: shields the text column on wide screens,
            where the banner's own typography would sit behind the headline. */}
        <div
          class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/60 via-ink/20 to-transparent"
          aria-hidden="true"
        />
      </>
    ) : (
      <div class="absolute inset-0 -z-10 bg-gradient-to-b from-cream to-white" aria-hidden="true" />
    )
  }

  <div
    class:list={[
      'mx-auto flex max-w-[1080px] flex-col items-start px-5 text-left md:px-10',
      image
        ? // text-shadow is inherited, so the whole stack stays readable over
          // the banner's baked-in artwork.
          'min-h-[68dvh] justify-end pt-[120px] pb-14 [text-shadow:0_2px_24px_rgba(20,19,21,0.55)] md:min-h-[76dvh] md:pb-20'
        : compact
          ? 'pt-[125px] pb-12 md:pt-[145px] md:pb-14'
          : 'pt-[135px] pb-14 md:pt-[160px] md:pb-20',
    ]}
  >
    <Eyebrow onDark={onDark}>{eyebrow}</Eyebrow>
    <h1
      class:list={[
        'mt-4 max-w-3xl leading-[1.06]',
        image ? 'text-5xl md:text-7xl' : 'text-4xl md:text-5xl',
        onDark ? 'text-white' : 'text-ink',
      ]}
    >
      {title}
    </h1>
    {
      body && (
        <p
          class:list={[
            'mt-5 max-w-2xl text-base leading-[1.7] md:text-lg',
            onDark ? 'text-white/85' : 'text-ink/65',
          ]}
        >
          {body}
        </p>
      )
    }
    {
      Astro.slots.has('default') && (
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <slot />
        </div>
      )
    }
  </div>
</section>
