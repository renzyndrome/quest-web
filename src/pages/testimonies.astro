---
/*
  Life Testimonies listing. Flat file beside the testimonies/ directory, the
  same arrangement news.astro uses next to news/.
*/
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import TestimonyCard from '../components/TestimonyCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import { getTestimonies } from '../lib/testimonies';

const testimonies = await getTestimonies();
---

<Base
  title="Life testimonies | Quest Laguna"
  description="Stories from people in our church about what God has done in their lives."
>
  <HeroBanner
    eyebrow="Testimonies"
    title="Life testimonies"
    body="Members of the church tell what God has done in their lives."
  />

  <section class="px-gutter py-section" aria-label="Life testimonies">
    <div class="mx-auto max-w-content">
      {
        testimonies.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2">
            {testimonies.map((testimony) => (
              <TestimonyCard testimony={testimony} />
            ))}
          </div>
        ) : (
          <div class="max-w-narrow rounded-card border border-cream-200 bg-cream px-8 py-12">
            <h2 class="text-title-lg">No stories posted yet</h2>
            <p class="mt-2 text-body text-ink/65">
              Stories are shared at our gatherings and posted here as they are written up.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <section class="bg-cream px-gutter py-section" aria-label="Told in person">
    <div class="mx-auto grid max-w-content items-center gap-10 md:grid-cols-2">
      <img
        src="/images/site/testimony-sharing.webp"
        alt="A member sharing her testimony at the lectern during a Sunday service"
        width={1200}
        height={675}
        loading="lazy"
        decoding="async"
        class="h-auto w-full rounded-media shadow-media"
      />
      <div>
        {/* /connect offers a prayer request and a question form, not a story
            submission, so the link promises only what that page can do. */}
        <SectionHeading
          title="Told in person."
          body="Most of these stories are first shared with the congregation during a service."
        />
        <div class="mt-7">
          <Button href="/connect">Send us a message</Button>
        </div>
      </div>
    </div>
  </section>
</Base>
