# LOCAL DEVELOPMENT ONLY — committed on purpose, contains no real secrets.
#
# Used via:
#   docker compose --env-file local.env \
#     -f docker-compose.yml -f docker-compose.local.yml up --build
#
# It exists because docker-compose.yml guards PAYLOAD_SECRET and DB_PASSWORD
# with `${VAR:?}` so a production deploy fails loudly when they are missing.
# Compose resolves those guards before any overlay applies, so the values have
# to arrive as environment variables — which is what this file provides.
#
# Never reuse these values anywhere reachable from the internet.

PAYLOAD_SECRET=local-dev-secret-not-for-production
DB_PASSWORD=devpass
DB_USER=payload
DB_DATABASE=quest_content

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
SITE_ORIGIN=http://localhost:4321
SITE_URL=http://localhost:4321

# Puts the "Preview" button next to Save. Must match the site's
# PREVIEW_SECRET, which the Makefile defaults to this same value — so the
# button opens a working preview against `make dev`.
PREVIEW_SECRET=localpreview

# Load the church's starting content (photo library, announcements, events).
SEED_ON_BOOT=true

# Creates a local admin so you can log straight in. Production sets neither of
# these, so Payload shows its onboarding screen and the first real admin
# chooses their own password.
SEED_ADMIN_EMAIL=admin@questlaguna.local
SEED_ADMIN_PASSWORD=localdev12345
