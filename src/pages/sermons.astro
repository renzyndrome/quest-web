---
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import PillButton from '../components/PillButton.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { SERVICES, sampleSermons } from '../lib/sample-content';
import { YT_UPLOADS_PLAYLIST, YT_CHANNEL_URL } from '../lib/youtube';

// Archive entries are placeholders (videoId: null → uploads-playlist facade).
// Production: fetch per-service YouTube playlists at build time.
const serviceName = (slug: string) => SERVICES.find((s) => s.slug === slug)?.name ?? slug;
const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' });
---

<Base title="Sermons & services — Quest Laguna">
  <HeroBanner
    eyebrow="Watch again"
    title="Sermons & services"
    body="Missed a service? Everything is recorded. Watch the latest one below, or browse the archive by service."
    compact
  />

  <section class="px-5 pb-16 md:px-10" aria-label="Latest service">
    <div class="mx-auto max-w-[1080px]">
      <YouTubeEmbed
        playlistId={YT_UPLOADS_PLAYLIST}
        title="Latest Quest Laguna service"
        class="rounded-card shadow-media"
      />
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-ink/60">
          From our YouTube channel. This updates automatically every week.
        </p>
        <PillButton href={YT_CHANNEL_URL} variant="outline">View channel</PillButton>
      </div>
    </div>
  </section>

  <section class="bg-cream px-5 py-16 md:px-10 md:py-20" aria-label="Our services">
    <div class="mx-auto max-w-[1080px]">
      <Eyebrow>Our services</Eyebrow>
      <h2 class="mt-3 text-3xl md:text-4xl">Four services, every week.</h2>
      <p class="mt-3 max-w-2xl text-[15px] leading-[1.7] text-ink/65">
        We gather four times a week. Each service has its own recordings in the archive below.
      </p>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          SERVICES.map((service) => (
            <button
              type="button"
              data-service-link={service.slug}
              class="rounded-card border border-ink/5 bg-white px-6 py-7 text-left transition-shadow duration-200 hover:shadow-card"
            >
              <p class="text-xs font-bold tracking-[0.12em] text-maroon uppercase">
                {service.schedule}
              </p>
              <h3 class="mt-2 text-lg">{service.name}</h3>
              <p class="mt-1.5 text-sm text-ink/60">{service.description}</p>
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <section id="archive" class="px-5 py-16 md:px-10 md:py-24" aria-label="Service archive">
    <div class="mx-auto max-w-[1080px]">
      <Eyebrow>Archive</Eyebrow>
      <h2 class="mt-3 text-3xl md:text-4xl">Watch a past service.</h2>

      <div class="mt-8 flex flex-wrap gap-2.5" aria-label="Filter by service">
        {
          [{ slug: 'all', name: 'All' }, ...SERVICES].map((tab, i) => (
            <button
              type="button"
              data-tab={tab.slug}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="min-h-11 rounded-full border border-ink/10 bg-white px-5 py-2.5 text-sm font-semibold text-ink/70 transition-colors duration-200 hover:border-brand/50 aria-pressed:border-transparent aria-pressed:bg-brand aria-pressed:text-white"
            >
              {tab.name}
            </button>
          ))
        }
      </div>

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          sampleSermons.map((sermon) => (
            <article
              data-sermon
              data-service={sermon.service}
              class="overflow-hidden rounded-card border border-ink/5 bg-white shadow-card"
            >
              <YouTubeEmbed
                videoId={sermon.videoId}
                playlistId={YT_UPLOADS_PLAYLIST}
                title={sermon.title}
              />
              <div class="p-5">
                <span class="rounded-full bg-red-tint px-3 py-1 text-[10px] font-bold tracking-widest text-maroon uppercase">
                  {serviceName(sermon.service)}
                </span>
                <h3 class="mt-2.5 text-base">{sermon.title}</h3>
                <p class="mt-1 text-[13px] text-ink/55">{formatDate(sermon.date)}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-14 flex flex-col items-center gap-4 text-center">
        <h3 class="text-xl">Looking for an older recording?</h3>
        <PillButton href={YT_CHANNEL_URL}>Browse the full archive on YouTube</PillButton>
        <p class="text-sm text-ink/55">
          Services also stream live on our
          <a
            href="https://facebook.com/questlaguna"
            rel="noopener"
            class="font-semibold text-maroon underline underline-offset-4">Facebook page</a
          >.
        </p>
      </div>
    </div>
  </section>

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-sermon]'));

    function setFilter(value: string) {
      tabs.forEach((tab) => tab.setAttribute('aria-pressed', String(tab.dataset.tab === value)));
      cards.forEach((card) => {
        card.hidden = value !== 'all' && card.dataset.service !== value;
      });
    }

    tabs.forEach((tab) => tab.addEventListener('click', () => setFilter(tab.dataset.tab ?? 'all')));

    const smooth = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ? 'auto'
      : 'smooth';
    document.querySelectorAll<HTMLButtonElement>('[data-service-link]').forEach((button) =>
      button.addEventListener('click', () => {
        setFilter(button.dataset.serviceLink ?? 'all');
        document.getElementById('archive')?.scrollIntoView({ behavior: smooth as ScrollBehavior });
      }),
    );
  </script>
</Base>
